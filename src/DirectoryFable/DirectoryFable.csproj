<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Viewer/PdfFile.cs and Viewer/WebPEncoder.cs hand pixel buffers to native libraries. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The native DLLs (pdfium, libwebp) go into the single-file exe; .NET unpacks them once per version into the
         user's temp folder and loads them from there. The release stays one exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Only for the tray icon (NotifyIcon); part of the Windows Desktop runtime, no extra package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF0001: ThemeMode (Fluent theme) is marked experimental.
         WFO0003: WinForms analyzer wants DPI mode set via Application.SetHighDpiMode; this is a
         WPF app (WinForms only for the tray icon), so the manifest DPI setting is correct. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The app's version: the update check compares it with the GitHub release tags (v<Version>),
         and build.ps1 names the release zip after it. -->
    <Version>1.4.2</Version>
    <!-- The version text is only the number (no "+<commit id>" of the build's repository). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Release: the debug data in the exe (and stack traces) name the source files by their place in the project
         (src\DirectoryFable\...), not by the folder they were built in on the build machine. -->
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)\=src\DirectoryFable\</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF share many type names; keep WinForms out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Title bar tab icons of the built-in views (sources: the .svg files next to them). -->
    <Resource Include="Assets\notepad.ico" />
    <Resource Include="Assets\astraviewer.ico" />
    <Resource Include="Assets\sonnetsearch.ico" />
    <Resource Include="Assets\opushc.ico" />
    <Resource Include="Assets\keeseek.ico" />
    <Resource Include="Assets\gemmachat.ico" />
    <Resource Include="Assets\flashsync.ico" />
    <!-- Icons for files in the Notepad# list (right-click, Icon): <id>-<size>.png, see Editor/FileIcons.cs. -->
    <Resource Include="Assets\NotepadIcons\*.png" />
    <!-- Notepad# syntax definitions (AutoHotkey, INI): loaded by Editor/EditorHighlighting.cs. -->
    <EmbeddedResource Include="Editor\Syntax\*.xshd" />
    <!-- Technical Notes: a TextMate grammar (from its VS Code language mode), read by Editor/TextMateLine.cs. -->
    <EmbeddedResource Include="Editor\Syntax\*.tmLanguage.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- GemmaChat: the official Anthropic SDK (Apache-2.0) for Claude's API (Chat/ClaudeClient.cs). -->
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- OpusHC: the .NET binding of VLC's engine (LGPL-2.1). The engine itself (libVLC) is not shipped:
         it is downloaded on first use into the data folder (Player/VlcEngine.cs). -->
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <!-- AstraViewer: PDFium (the PDF engine of Chromium; BSD-3-Clause / Apache-2.0) draws PDF pages and gives their text
         (Viewer/PdfFile.cs). A native pdfium.dll: it is inside the single-file exe and unpacked at the start. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8152" />
    <!-- AstraViewer: Google's libwebp (BSD-3-Clause) writes WebP files (Viewer/WebPEncoder.cs); native DLLs, as above. -->
    <PackageReference Include="Imazen.WebP.NativeRuntime.win-x64" Version="1.6.1" />
  </ItemGroup>

</Project>
