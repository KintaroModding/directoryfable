<Window x:Class="DirectoryFable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DirectoryFable.Views"
        Title="DirectoryFable"
        Width="1400" Height="850"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        UseLayoutRounding="True"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ListTextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}">
    <!-- Own title bar: the Windows title bar has a fixed height. The
         resize border and the glass frame stay with Windows. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource TitleBarHeight}"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- Padding is set while maximized: Windows puts the border of a maximized window off screen. -->
    <Border x:Name="RootBorder">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Title bar: app icon, the active folder's name (= Title), caption buttons. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="5" Height="{StaticResource TitleBarHeight}"
              Background="{StaticResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/app.ico" Width="16" Height="16" Margin="10,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <!-- View tabs: [active folder] = explorer, [Notepad#] = text editor, [AstraViewer] = images, [SonnetSearch] = file search. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ExplorerTab" Style="{StaticResource TitleTabButton}" IsChecked="True"
                              ToolTip="Explorer" Click="ExplorerTab_Click">
                    <!-- Fixed width (about 28 characters, set in MainWindow.TitleBar.cs): the tabs never move; longer names end in "...". -->
                    <TextBlock x:Name="ExplorerTabText" Text="DirectoryFable" TextTrimming="CharacterEllipsis" />
                </ToggleButton>
                <ToggleButton x:Name="NotepadTab" Style="{StaticResource TitleTabButton}"
                              ToolTip="Notepad# (text editor)" Click="NotepadTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/notepad.ico" Style="{StaticResource TitleTabIcon}" />
                        <TextBlock Text="Notepad#" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="AstraViewerTab" Style="{StaticResource TitleTabButton}"
                              ToolTip="AstraViewer (images)" Click="AstraViewerTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/astraviewer.ico" Style="{StaticResource TitleTabIcon}" />
                        <TextBlock Text="AstraViewer" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="SearchTab" Style="{StaticResource TitleTabButton}"
                              ToolTip="SonnetSearch: find files on whole drives (Ctrl+F in the explorer: search in the shown folder)" Click="SearchTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/sonnetsearch.ico" Style="{StaticResource TitleTabIcon}" />
                        <TextBlock Text="SonnetSearch" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="PlayerTab" Style="{StaticResource TitleTabButton}"
                              ToolTip="OpusHC (videos)" Click="PlayerTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/opushc.ico" Style="{StaticResource TitleTabIcon}" />
                        <TextBlock Text="OpusHC" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="KeeSeekTab" Style="{StaticResource TitleTabButton}"
                              ToolTip="KeeSeek (passwords)" Click="KeeSeekTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/keeseek.ico" Style="{StaticResource TitleTabIcon}" />
                        <TextBlock Text="KeeSeek" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="GemmaChatTab" Style="{StaticResource TitleTabButton}"
                              ToolTip="GemmaChat (AI chat)" Click="GemmaChatTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/gemmachat.ico" Style="{StaticResource TitleTabIcon}" />
                        <TextBlock Text="GemmaChat" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <!-- Update: GitHub's newest release, what changed, update on a click (MainWindow.Update.cs). -->
                <ToggleButton x:Name="UpdateButton" Style="{StaticResource TitleTabButton}" Margin="0,0,6,0"
                              VerticalAlignment="Center" Click="UpdateButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateButtonIcon" FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE896;"
                                   Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="UpdateButtonText" Text="Update" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="UpdatePopup" PlacementTarget="{Binding ElementName=UpdateButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" Closed="UpdatePopup_Closed">
                    <views:UpdatePanel x:Name="UpdatePage" Margin="0,4,12,12" />
                </Popup>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize"
                        Click="Minimize_Click" />
                <!-- Mouse input reaches this button as HTMAXBUTTON (Windows 11 snap layouts); see MainWindow.TitleBar.cs. -->
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="Maximize_Click" />
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Close"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- Shared favorites bar across the top; acts on the active pane. -->
        <!-- App-wide actions (Undo), same size as the favorites bar. -->
        <views:ActionBar x:Name="Actions" Grid.Row="1" Grid.ColumnSpan="5" />

        <views:FavoritesBar x:Name="Favorites" Grid.Row="2" Grid.ColumnSpan="5" />

        <!-- Shared folder tree on the far left; acts on the active pane. -->
        <views:FolderTree x:Name="FolderTreeView" Grid.Row="3" Grid.Column="0" />

        <GridSplitter x:Name="TreeSplitter" Grid.Row="3" Grid.Column="1" Style="{StaticResource SplitterStyle}" />

        <views:PaneView x:Name="LeftPane" Grid.Row="3" Grid.Column="2"
                        PreviewMouseDown="Pane_PreviewMouseDown"
                        PreviewGotKeyboardFocus="Pane_PreviewGotKeyboardFocus" />

        <GridSplitter x:Name="PaneSplitter" Grid.Row="3" Grid.Column="3" Style="{StaticResource SplitterStyle}" />

        <views:PaneView x:Name="RightPane" Grid.Row="3" Grid.Column="4"
                        PreviewMouseDown="Pane_PreviewMouseDown"
                        PreviewGotKeyboardFocus="Pane_PreviewGotKeyboardFocus" />

        <!-- Settings page: covers favorites, tree and panes while open (gear button / Esc). -->
        <views:SettingsView x:Name="SettingsPage" Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="5"
                            Visibility="Collapsed" />

        <!-- Notepad#: covers everything below the title bar while shown (title bar tabs). -->
        <views:NotepadView x:Name="NotepadPage" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="5"
                           Visibility="Collapsed" />

        <!-- AstraViewer: covers everything below the title bar while shown (title bar tabs). -->
        <views:AstraViewerView x:Name="AstraViewerPage" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="5"
                               Visibility="Collapsed" />

        <!-- SonnetSearch: covers everything below the title bar while shown (title bar tabs). -->
        <views:SearchView x:Name="SearchPage" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="5"
                          Visibility="Collapsed" />

        <!-- OpusHC: covers everything below the title bar while shown (title bar tabs; full screen: all of it). -->
        <views:OpusPlayerView x:Name="PlayerPage" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="5"
                              Visibility="Collapsed" />

        <!-- KeeSeek: covers everything below the title bar while shown (title bar tabs). -->
        <views:KeeSeekView x:Name="KeeSeekPage" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="5"
                           Visibility="Collapsed" />

        <!-- GemmaChat: covers everything below the title bar while shown (title bar tabs). -->
        <views:GemmaChatView x:Name="GemmaChatPage" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="5"
                             Visibility="Collapsed" />
    </Grid>
    </Border>
</Window>
