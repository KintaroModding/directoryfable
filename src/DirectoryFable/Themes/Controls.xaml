<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:DirectoryFable.Infrastructure"
                    xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <infra:DepthToIndentConverter x:Key="DepthToIndent" />
    <infra:GroupExpandedConverter x:Key="GroupExpanded" />

    <!-- Flat button: no border, square (like the field lists), light fill on hover. -->
    <Style x:Key="SubtleButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small white icon button for the navigation bar. -->
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Column header: flat dark bar, gray text, thin separators, resizable. -->
    <Style x:Key="ColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource ColumnHeaderTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ColumnHeaderBackgroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <Border BorderBrush="{StaticResource ColumnHeaderSeparatorBrush}"
                                BorderThickness="0,0,1,1" Padding="7,0,6,0">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8"
                               Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ColumnHeaderHoverBrush}" />
                        </Trigger>
                        <!-- The empty filler header right of the last column: no separator, no hover. -->
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ColumnHeaderBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ColumnHeaderRightStyle" TargetType="GridViewColumnHeader"
           BasedOn="{StaticResource ColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- File list: normal background; inside a ZIP another background (settings.json
         "archiveBackground", applied at start, hence DynamicResource). -->
    <Style x:Key="FileListStyle" TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
        <Setter Property="Background" Value="{StaticResource ListBackgroundBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsInArchive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ArchiveListBackgroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- File row: 20 DIP, blue selection, gray 1 px focus rectangle. -->
    <Style x:Key="FileRowStyle" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
        <!-- The row's resting color; hover and selection draw over it (template triggers). -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                            BorderThickness="1" SnapsToDevicePixels="True">
                        <GridViewRowPresenter x:Name="Cells" VerticalAlignment="Center"
                                              Columns="{TemplateBinding GridView.ColumnCollection}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelectedBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelectedHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRectBrush}" />
                        </Trigger>
                        <!-- Drag and drop: this folder row is the drop target. -->
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GroupChevronBrush}" />
                        </DataTrigger>
                        <!-- Cut (Ctrl+X), not yet pasted: faded like Explorer; selection stays visible. -->
                        <DataTrigger Binding="{Binding IsCut}" Value="True">
                            <Setter TargetName="Cells" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- File rows with every second row a little lighter (set AlternationCount="2" on the list). -->
    <Style x:Key="AlternatingFileRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource FileRowStyle}">
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="{StaticResource ListAlternateRowBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tab header: fixed width, black when inactive, dark gray when selected, no close button. -->
    <Style x:Key="TabHeaderStyle" TargetType="Border">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="24" />
        <!-- Fine line between tabs. -->
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Background" Value="{StaticResource TabInactiveBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TabInactiveTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource TabActiveBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource TabActiveTextBrush}" />
            </DataTrigger>
            <!-- Faded while it is dragged to a new place. -->
            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                <Setter Property="Opacity" Value="0.35" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="False" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#101010" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Group divider of the file list:
         blue chevron, white "Type (count)", thin gray line to the right edge, 30 DIP high.
         Click to collapse / expand the group. -->
    <Style x:Key="FileGroupContainerStyle" TargetType="GroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <StackPanel>
                        <!-- The list measures its rows with unlimited width (horizontal scrolling), so a
                             "*" column would get 0 and the line would vanish: use the visible width. -->
                        <!-- Open / closed comes from the tab (closed groups are remembered, also in the session). -->
                        <ToggleButton x:Name="Toggle" Focusable="False" Height="30"
                                      HorizontalAlignment="Left"
                                      Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <ToggleButton.IsChecked>
                                <MultiBinding Converter="{StaticResource GroupExpanded}" Mode="OneTime">
                                    <Binding Path="Name" />
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                </MultiBinding>
                            </ToggleButton.IsChecked>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent" Margin="9,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Bold chevron: down when open, right when collapsed. -->
                                        <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource GroupChevronBrush}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5" />
                                        <TextBlock Grid.Column="1" FontSize="14" Foreground="{StaticResource ListTextBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <Rectangle Grid.Column="2" Height="1" Margin="8,2,0,0" VerticalAlignment="Center"
                                                   Fill="{StaticResource SecondaryTextBrush}" SnapsToDevicePixels="True" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ItemsPresenter x:Name="GroupItems" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Toggle" Property="IsChecked" Value="False">
                            <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Folder tree expander: boxed green + / -. The box is 13 DIP, but the
         whole 20 x 20 DIP cell around it reacts (transparent background), so a click slightly
         beside the box still opens the folder instead of selecting the row.
         Hover: brighter frame. -->
    <Style x:Key="BoxExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Box" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource ExpanderFillBrush}" BorderBrush="{StaticResource ExpanderBorderBrush}"
                                BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle Height="1" Width="7" Fill="{StaticResource ExpanderSignBrush}" SnapsToDevicePixels="True" />
                                <Rectangle x:Name="Vertical" Width="1" Height="7" Fill="{StaticResource ExpanderSignBrush}" SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Vertical" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ExpanderHoverBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Folder tree row: full-width gray selection, indentation by depth, no dotted lines. -->
    <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" Height="20" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                                <!-- 20 DIP wide, full row height: the whole cell toggles. -->
                                <ToggleButton x:Name="Expander" Style="{StaticResource BoxExpanderStyle}"
                                              Width="20" Height="18" Margin="0,0,3,0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TreeSelectedBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GroupChevronBrush}" />
                        </DataTrigger>
                        <!-- The "loading" placeholder child is never shown. -->
                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Small gap below each top-level group (Home, Desktop, ..., This PC). -->
                        <DataTrigger Binding="{Binding Depth}" Value="0">
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Splitter: dark 4 px strip with a fine #404040 line on each side. -->
    <Style x:Key="SplitterStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="{StaticResource SplitterBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Caption buttons of the own title bar (Windows 11 look: 46 DIP wide, icon glyphs). -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptionCloseHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CaptionClosePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small on/off icon button for headers (folder tree "follow"): blue when on, gray when off. -->
    <Style x:Key="HeaderToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="20" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource HeaderToggleOffBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GroupChevronBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quick actions bar (file pane): icon + label buttons. -->
    <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Foreground" Value="{StaticResource BreadcrumbTextBrush}" />
    </Style>

    <Style x:Key="QuickIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,1,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Action bar toggle (Settings): like SubtleButton, stays highlighted while checked. -->
    <Style x:Key="BarToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TreeSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- File row "properties" button: a dim info glyph at the right end of the
         Name column, bright on hover. Not focusable, so keys stay in the list. -->
    <Style x:Key="RowInfoButton" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="4,0,2,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource RowInfoBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar view tab ([folder] [Notepad#]): highlighted while its view is shown.
         Hit-testable inside the WindowChrome caption. -->
    <!-- Icon left of a view tab's name (16 px, like the app icon at the left of the title bar). -->
    <Style x:Key="TitleTabIcon" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <!-- Title bar tab, flat like the field lists: square; under the mouse the field color, the shown view the field's
         hover color. The button is as high as the title bar, so a click on the screen's top edge (window maximized)
         hits it; only its middle 26 px show the background. -->
    <Style x:Key="TitleTabButton" TargetType="ToggleButton">
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" Height="26" VerticalAlignment="Center" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Notepad# search box (Ctrl+F, AvalonEdit's SearchPanel) in the dark look: the search
         text, the options as small toggles (Aa = match case, ab = whole words, .* = regular
         expression), previous / next match, close. Enter / F3 = next, Shift+Enter / Shift+F3 =
         previous, Esc closes. The arrow on the left (or Ctrl+H) shows the replace row (Tag "replace"):
         Replace (Enter in its box) and Replace all (Ctrl+Alt+Enter); wired in NotepadView. -->
    <Style x:Key="SearchOptionToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource BreadcrumbTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1F3A54" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GroupChevronBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchPanelButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style TargetType="search:SearchPanel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="search:SearchPanel">
                    <Border Background="#252526" BorderBrush="#454545" BorderThickness="1"
                            Padding="5,4" Margin="0,2,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Arrow"
                            TextElement.FontFamily="{StaticResource UiFont}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.55" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Show / hide the replace row. -->
                            <Button x:Name="ReplaceToggle" Grid.RowSpan="2" Style="{StaticResource SearchPanelButton}" Margin="0,0,4,0"
                                    Height="Auto" VerticalAlignment="Stretch" ToolTip="Replace (Ctrl+H)">
                                <TextBlock x:Name="ReplaceChevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Name="PART_searchTextBox" Width="260" Height="26" MinHeight="0" Padding="4,0"
                                         VerticalContentAlignment="Center" FontSize="13" ToolTip="Find (Enter: next, Shift+Enter: previous)">
                                    <TextBox.Text>
                                        <Binding Path="SearchPattern" RelativeSource="{RelativeSource TemplatedParent}" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <ExceptionValidationRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <ToggleButton Style="{StaticResource SearchOptionToggle}" Margin="6,0,0,0" Content="Aa" ToolTip="Match case"
                                              IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ToggleButton Style="{StaticResource SearchOptionToggle}" ToolTip="Match whole words"
                                              IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock Text="ab" TextDecorations="Underline" />
                                </ToggleButton>
                                <ToggleButton Style="{StaticResource SearchOptionToggle}" Content=".*" ToolTip="Use regular expressions"
                                              IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Rectangle Width="1" Height="16" Margin="6,0,4,0" Fill="{StaticResource LineBrush}" />
                                <Button Style="{StaticResource SearchPanelButton}" Content="&#xE70E;" ToolTip="Previous match (Shift+F3)"
                                        Command="search:SearchCommands.FindPrevious"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                <Button Style="{StaticResource SearchPanelButton}" Content="&#xE70D;" ToolTip="Next match (F3)"
                                        Command="search:SearchCommands.FindNext"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                <Button x:Name="FindAllButton" Style="{StaticResource SubtleButton}" Margin="2,0,2,0" Padding="8,0" Height="22"
                                        Content="Find all" ToolTip="List every line of this file with a match, in the panel below (Alt+Enter)" />
                                <Button Style="{StaticResource SearchPanelButton}" Content="&#xE711;" ToolTip="Close (Esc)"
                                        Command="search:SearchCommands.CloseSearchPanel"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                            <!-- Replace: the new text; with a regular expression $1, $2 ... take the groups of the match. -->
                            <StackPanel x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="Collapsed">
                                <TextBox x:Name="ReplaceBox" Width="260" Height="26" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center"
                                         FontSize="13" ToolTip="Replace with (Enter: replace this match, Ctrl+Alt+Enter: replace all; $1 = a group of a regular expression)" />
                                <Button x:Name="ReplaceOneButton" Style="{StaticResource SubtleButton}" Margin="6,0,0,0" Padding="8,0" Height="22"
                                        Content="Replace" ToolTip="Replace this match and go to the next one (Enter)" />
                                <Button x:Name="ReplaceAllButton" Style="{StaticResource SubtleButton}" Margin="2,0,0,0" Padding="8,0" Height="22"
                                        Content="Replace all" ToolTip="Replace every match in the file (Ctrl+Alt+Enter; one Undo takes it back)" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="replace">
                            <Setter TargetName="ReplaceRow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ReplaceChevron" Property="Text" Value="&#xE70D;" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists as flat fields, not buttons: a flat #262626 field 26 px high, the bar's text
         size, a small arrow on the right; editable lists get a plain text box. The standard combo box is taller
         and rounded; this own template fits the bars. Used by GemmaChat's bar and SonnetSearch's filters. -->
    <Style x:Key="FieldComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="10,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FieldComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FavoritesFontSize}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- The whole field opens the list; the arrow sits on the right. -->
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Padding="0" MinWidth="0" MinHeight="0"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource FieldBrush}">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="0,1,9,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="10,0,26,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="8,0,24,0" VerticalAlignment="Center"
                                 MinHeight="0" MinWidth="0" Padding="0" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{StaticResource ListTextBrush}" FontSize="{TemplateBinding FontSize}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text boxes as the same flat field (SonnetSearch's search box and extensions box): #262626, 26 px high, the bar's
         text size; a lighter field under the mouse and a thin blue line at the bottom while typing. -->
    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource ListTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FavoritesFontSize}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,1">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GroupChevronBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
