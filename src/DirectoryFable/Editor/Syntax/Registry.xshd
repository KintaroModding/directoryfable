<?xml version="1.0"?>
<!-- Windows registry files for Notepad#: comments, [keys], value names, value types. -->
<SyntaxDefinition name="Registry" extensions=".reg" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Escape" foreground="#D7BA7D" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="Key" foreground="#9CDCFE" />
  <Color name="Directive" foreground="#C586C0" />
  <Color name="Section" foreground="#569CD6" fontWeight="bold" />

  <RuleSet ignoreCase="true">
    <Span color="Comment" begin="^\s*;" />
    <Rule color="Section">^\s*\[-?[^\]\r\n]*\]</Rule>
    <Rule color="Directive">^(Windows\ Registry\ Editor\ Version\ [\d.]+|REGEDIT4)\s*$</Rule>
    <Rule color="Key">^\s*("([^"\\]|\\.)*"|@)(?=\s*=)</Rule>
    <Span color="String" begin="&quot;" end="&quot;|$">
      <RuleSet>
        <Span color="Escape" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Rule color="Type">(?&lt;==\s*)(dword|qword|hex(\([0-9a-fA-F]+\))?)(?=:)</Rule>
    <Rule color="Number">(?&lt;=:)[0-9a-fA-F]{2,}\b|\b[0-9a-fA-F]{2}(?=,|\s*\\?$)</Rule>
  </RuleSet>
</SyntaxDefinition>
