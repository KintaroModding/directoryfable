<?xml version="1.0"?>
<!-- TypeScript for Notepad#: comments, strings and template strings, keywords, types, decorators. -->
<SyntaxDefinition name="TypeScript" extensions=".ts;.tsx;.mts;.cts" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Escape" foreground="#D7BA7D" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Keyword" foreground="#569CD6" />
  <Color name="Control" foreground="#C586C0" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="Function" foreground="#DCDCAA" />
  <Color name="Constant" foreground="#4FC1FF" />
  <Color name="Directive" foreground="#C586C0" />

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="String" begin="&quot;" end="&quot;|$">
      <RuleSet>
        <Span color="Escape" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String" begin="'" end="'|$">
      <RuleSet>
        <Span color="Escape" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String" multiline="true" begin="`" end="`">
      <RuleSet>
        <Span color="Escape" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Rule color="Directive">@[A-Za-z_]\w*</Rule>
    <Keywords color="Control"><Word>if</Word><Word>else</Word><Word>for</Word><Word>while</Word><Word>do</Word><Word>switch</Word><Word>case</Word><Word>default</Word><Word>break</Word><Word>continue</Word><Word>return</Word><Word>throw</Word><Word>try</Word><Word>catch</Word><Word>finally</Word><Word>yield</Word><Word>await</Word><Word>import</Word><Word>export</Word><Word>from</Word><Word>as</Word></Keywords>
    <Keywords color="Keyword"><Word>var</Word><Word>let</Word><Word>const</Word><Word>function</Word><Word>class</Word><Word>extends</Word><Word>implements</Word><Word>interface</Word><Word>type</Word><Word>enum</Word><Word>namespace</Word><Word>module</Word><Word>declare</Word><Word>abstract</Word><Word>public</Word><Word>private</Word><Word>protected</Word><Word>readonly</Word><Word>static</Word><Word>override</Word><Word>async</Word><Word>new</Word><Word>delete</Word><Word>typeof</Word><Word>instanceof</Word><Word>in</Word><Word>of</Word><Word>keyof</Word><Word>infer</Word><Word>is</Word><Word>satisfies</Word><Word>asserts</Word><Word>unique</Word><Word>get</Word><Word>set</Word><Word>constructor</Word><Word>super</Word><Word>this</Word><Word>void</Word></Keywords>
    <Keywords color="Type"><Word>string</Word><Word>number</Word><Word>boolean</Word><Word>any</Word><Word>unknown</Word><Word>never</Word><Word>object</Word><Word>symbol</Word><Word>bigint</Word><Word>Array</Word><Word>Promise</Word><Word>Record</Word><Word>Partial</Word><Word>Readonly</Word><Word>Pick</Word><Word>Omit</Word><Word>Map</Word><Word>Set</Word><Word>Date</Word><Word>RegExp</Word><Word>Error</Word></Keywords>
    <Keywords color="Constant"><Word>true</Word><Word>false</Word><Word>null</Word><Word>undefined</Word><Word>NaN</Word><Word>Infinity</Word></Keywords>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b|\b0[bB][01_]+\b|\b\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?\w*\b</Rule>
  </RuleSet>
</SyntaxDefinition>
