<?xml version="1.0"?>
<!-- YAML for Notepad#: comments, keys, strings, anchors, tags, true / false / null. -->
<SyntaxDefinition name="YAML" extensions=".yml;.yaml;.clang-format" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Escape" foreground="#D7BA7D" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="Constant" foreground="#4FC1FF" />
  <Color name="Key" foreground="#9CDCFE" />
  <Color name="Punctuation" foreground="#808080" />
  <Color name="Directive" foreground="#C586C0" />
  <Color name="Label" foreground="#4EC9B0" />

  <RuleSet>
    <Span color="Comment" begin="(^|(?&lt;=\s))\#" />
    <Rule color="Directive">^(---|\.\.\.)\s*$</Rule>
    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet>
        <Span color="Escape" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="String" begin="'" end="'" />
    <Rule color="Key">^\s*(-\s+)*[^\s\#:\-&amp;*!|&gt;\'"%@`{\[][^:\#\r\n]*?(?=\s*:(\s|$))</Rule>
    <Rule color="Type">![\w!./-]*</Rule>
    <Rule color="Label">[&amp;*][\w-]+</Rule>
    <Rule color="Constant">(?&lt;=:\s+|-\s+)(true|false|null|yes|no|on|off|True|False|Null|TRUE|FALSE|NULL|~)(?=\s*($|\#))</Rule>
    <Rule color="Number">(?&lt;=:\s+|-\s+)[+-]?(\d[\d_]*(\.\d+)?([eE][+-]?\d+)?|0x[0-9a-fA-F]+)(?=\s*($|\#))</Rule>
    <Rule color="Punctuation">^\s*-(?=\s)|[|&gt;][+-]?(?=\s*$)</Rule>
  </RuleSet>
</SyntaxDefinition>
