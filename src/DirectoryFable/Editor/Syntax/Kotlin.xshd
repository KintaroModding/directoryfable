<?xml version="1.0"?>
<!-- Kotlin for Notepad#: comments, strings, keywords, types, annotations. -->
<SyntaxDefinition name="Kotlin" extensions=".kt;.kts" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Escape" foreground="#D7BA7D" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Keyword" foreground="#569CD6" />
  <Color name="Control" foreground="#C586C0" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="Function" foreground="#DCDCAA" />
  <Color name="Constant" foreground="#4FC1FF" />
  <Color name="Directive" foreground="#C586C0" />

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="String" multiline="true" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;" />
    <Span color="String" begin="&quot;" end="&quot;|$">
      <RuleSet>
        <Span color="Escape" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Rule color="String">'(\\.[^']*|[^\\'])'</Rule>
    <Rule color="Directive">@[A-Za-z_][\w.:]*</Rule>
    <Keywords color="Control"><Word>if</Word><Word>else</Word><Word>when</Word><Word>for</Word><Word>while</Word><Word>do</Word><Word>break</Word><Word>continue</Word><Word>return</Word><Word>throw</Word><Word>try</Word><Word>catch</Word><Word>finally</Word></Keywords>
    <Keywords color="Keyword"><Word>package</Word><Word>import</Word><Word>class</Word><Word>interface</Word><Word>object</Word><Word>fun</Word><Word>val</Word><Word>var</Word><Word>typealias</Word><Word>constructor</Word><Word>init</Word><Word>companion</Word><Word>data</Word><Word>sealed</Word><Word>enum</Word><Word>annotation</Word><Word>open</Word><Word>abstract</Word><Word>final</Word><Word>override</Word><Word>private</Word><Word>protected</Word><Word>public</Word><Word>internal</Word><Word>inner</Word><Word>lateinit</Word><Word>const</Word><Word>suspend</Word><Word>inline</Word><Word>noinline</Word><Word>crossinline</Word><Word>reified</Word><Word>vararg</Word><Word>operator</Word><Word>infix</Word><Word>tailrec</Word><Word>external</Word><Word>by</Word><Word>in</Word><Word>is</Word><Word>as</Word><Word>out</Word><Word>where</Word><Word>this</Word><Word>super</Word><Word>get</Word><Word>set</Word></Keywords>
    <Keywords color="Type"><Word>Any</Word><Word>Unit</Word><Word>Nothing</Word><Word>Boolean</Word><Word>Byte</Word><Word>Short</Word><Word>Int</Word><Word>Long</Word><Word>Float</Word><Word>Double</Word><Word>Char</Word><Word>String</Word><Word>Array</Word><Word>List</Word><Word>MutableList</Word><Word>Map</Word><Word>MutableMap</Word><Word>Set</Word><Word>MutableSet</Word><Word>Pair</Word></Keywords>
    <Keywords color="Constant"><Word>true</Word><Word>false</Word><Word>null</Word></Keywords>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b|\b0[bB][01_]+\b|\b\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?\w*\b</Rule>
  </RuleSet>
</SyntaxDefinition>
