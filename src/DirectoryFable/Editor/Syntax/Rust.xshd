<?xml version="1.0"?>
<!-- Rust for Notepad#: comments, strings, keywords, types, macros, attributes, lifetimes. -->
<SyntaxDefinition name="Rust" extensions=".rs" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Escape" foreground="#D7BA7D" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Keyword" foreground="#569CD6" />
  <Color name="Control" foreground="#C586C0" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="Function" foreground="#DCDCAA" />
  <Color name="Constant" foreground="#4FC1FF" />
  <Color name="Directive" foreground="#C586C0" />
  <Color name="Label" foreground="#4EC9B0" />

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="String" multiline="true" begin="&quot;" end="&quot;">
      <RuleSet>
        <Span color="Escape" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Rule color="String">'(\\[^']+|[^\\'])'</Rule>
    <Rule color="Directive">\#!?\[[^\]\r\n]*\]</Rule>
    <Rule color="Label">'[A-Za-z_]\w*</Rule>
    <Keywords color="Control"><Word>if</Word><Word>else</Word><Word>match</Word><Word>for</Word><Word>while</Word><Word>loop</Word><Word>break</Word><Word>continue</Word><Word>return</Word><Word>await</Word></Keywords>
    <Keywords color="Keyword"><Word>as</Word><Word>async</Word><Word>const</Word><Word>crate</Word><Word>dyn</Word><Word>enum</Word><Word>extern</Word><Word>fn</Word><Word>impl</Word><Word>in</Word><Word>let</Word><Word>mod</Word><Word>move</Word><Word>mut</Word><Word>pub</Word><Word>ref</Word><Word>self</Word><Word>Self</Word><Word>static</Word><Word>struct</Word><Word>super</Word><Word>trait</Word><Word>type</Word><Word>union</Word><Word>unsafe</Word><Word>use</Word><Word>where</Word></Keywords>
    <Keywords color="Type"><Word>bool</Word><Word>char</Word><Word>str</Word><Word>u8</Word><Word>u16</Word><Word>u32</Word><Word>u64</Word><Word>u128</Word><Word>usize</Word><Word>i8</Word><Word>i16</Word><Word>i32</Word><Word>i64</Word><Word>i128</Word><Word>isize</Word><Word>f32</Word><Word>f64</Word><Word>String</Word><Word>Vec</Word><Word>Option</Word><Word>Result</Word><Word>Box</Word><Word>Rc</Word><Word>Arc</Word><Word>HashMap</Word><Word>HashSet</Word></Keywords>
    <Keywords color="Constant"><Word>true</Word><Word>false</Word><Word>Some</Word><Word>None</Word><Word>Ok</Word><Word>Err</Word></Keywords>
    <Rule color="Function">\b[A-Za-z_]\w*!</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b|\b0[bB][01_]+\b|\b\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?\w*\b</Rule>
  </RuleSet>
</SyntaxDefinition>
