<?xml version="1.0"?>
<!-- Shader code (GLSL, HLSL, Unreal .usf / .ush) for Notepad#: comments, preprocessor, keywords, types. -->
<SyntaxDefinition name="Shader" extensions=".glsl;.vert;.frag;.geom;.comp;.tesc;.tese;.hlsl;.hlsli;.fx;.fxh;.shader;.cginc;.compute;.usf;.ush;.wgsl" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Escape" foreground="#D7BA7D" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Keyword" foreground="#569CD6" />
  <Color name="Control" foreground="#C586C0" />
  <Color name="Type" foreground="#4EC9B0" />
  <Color name="Function" foreground="#DCDCAA" />
  <Color name="Variable" foreground="#9CDCFE" />
  <Color name="Constant" foreground="#4FC1FF" />
  <Color name="Directive" foreground="#C586C0" />

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Rule color="Directive">^\s*\#\s*\w+</Rule>
    <Span color="String" begin="&quot;" end="&quot;|$">
      <RuleSet>
        <Span color="Escape" begin="\\" end="." />
      </RuleSet>
    </Span>
    <Keywords color="Control"><Word>if</Word><Word>else</Word><Word>for</Word><Word>while</Word><Word>do</Word><Word>switch</Word><Word>case</Word><Word>default</Word><Word>break</Word><Word>continue</Word><Word>return</Word><Word>discard</Word></Keywords>
    <Keywords color="Keyword"><Word>struct</Word><Word>uniform</Word><Word>varying</Word><Word>attribute</Word><Word>in</Word><Word>out</Word><Word>inout</Word><Word>const</Word><Word>static</Word><Word>inline</Word><Word>precision</Word><Word>highp</Word><Word>mediump</Word><Word>lowp</Word><Word>layout</Word><Word>cbuffer</Word><Word>tbuffer</Word><Word>register</Word><Word>technique</Word><Word>pass</Word><Word>packoffset</Word><Word>linear</Word><Word>centroid</Word><Word>nointerpolation</Word><Word>noperspective</Word><Word>flat</Word><Word>smooth</Word><Word>invariant</Word><Word>buffer</Word><Word>shared</Word><Word>namespace</Word><Word>class</Word><Word>interface</Word><Word>typedef</Word><Word>extern</Word><Word>volatile</Word><Word>row_major</Word><Word>column_major</Word><Word>fn</Word><Word>let</Word><Word>var</Word></Keywords>
    <Keywords color="Type"><Word>void</Word><Word>bool</Word><Word>int</Word><Word>uint</Word><Word>float</Word><Word>double</Word><Word>half</Word><Word>fixed</Word><Word>vec2</Word><Word>vec3</Word><Word>vec4</Word><Word>ivec2</Word><Word>ivec3</Word><Word>ivec4</Word><Word>uvec2</Word><Word>uvec3</Word><Word>uvec4</Word><Word>bvec2</Word><Word>bvec3</Word><Word>bvec4</Word><Word>dvec2</Word><Word>dvec3</Word><Word>dvec4</Word><Word>mat2</Word><Word>mat3</Word><Word>mat4</Word><Word>mat2x2</Word><Word>mat3x3</Word><Word>mat4x4</Word><Word>float2</Word><Word>float3</Word><Word>float4</Word><Word>float2x2</Word><Word>float3x3</Word><Word>float4x4</Word><Word>float3x4</Word><Word>float4x3</Word><Word>int2</Word><Word>int3</Word><Word>int4</Word><Word>uint2</Word><Word>uint3</Word><Word>uint4</Word><Word>half2</Word><Word>half3</Word><Word>half4</Word><Word>bool2</Word><Word>bool3</Word><Word>bool4</Word><Word>sampler</Word><Word>sampler1D</Word><Word>sampler2D</Word><Word>sampler3D</Word><Word>samplerCube</Word><Word>sampler2DArray</Word><Word>sampler2DShadow</Word><Word>Texture1D</Word><Word>Texture2D</Word><Word>Texture3D</Word><Word>TextureCube</Word><Word>Texture2DArray</Word><Word>SamplerState</Word><Word>SamplerComparisonState</Word></Keywords>
    <Keywords color="Constant"><Word>true</Word><Word>false</Word></Keywords>
    <Rule color="Variable">\bgl_\w+\b|\bSV_\w+\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b|\b0[bB][01_]+\b|\b\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?\w*\b</Rule>
  </RuleSet>
</SyntaxDefinition>
