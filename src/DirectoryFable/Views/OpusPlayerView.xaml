<UserControl x:Class="DirectoryFable.Views.OpusPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DirectoryFable.Views"
             xmlns:local="clr-namespace:DirectoryFable.Views"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}"
             Foreground="{StaticResource ListTextBrush}"
             Background="{StaticResource WindowBackgroundBrush}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="View_PreviewKeyDown">
    <!-- OpusHC: bar, the picture, the controls (timeline, play, volume, full screen). Full screen: the bar
         goes, the controls lie over the picture and hide when the mouse rests. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Bar: same size and look as AstraViewer's. -->
        <Border x:Name="TopBar" Grid.Row="0" Height="{StaticResource FavoritesBarHeight}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Background="{StaticResource WindowBackgroundBrush}">
            <DockPanel Margin="4,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="{StaticResource FavoritesFontSize}">
                    <ToggleButton x:Name="SettingsButton" Style="{StaticResource BarToggleButton}" Padding="7,1" Height="26"
                                  ToolTip="OpusHC settings" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                    <Button x:Name="AudioButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26" ToolTip="Audio track (language)" Click="Audio_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioText" Text="Audio" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SubtitleButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26" ToolTip="Subtitles" Click="Subtitles_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED1E;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SubtitleText" Text="Subtitles" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                    <Button x:Name="ShowInExplorerButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26" ToolTip="Show the video in the explorer" Click="ShowInExplorer_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Show in explorer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenExternalButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26" ToolTip="Open the video with its Windows program" Click="OpenExternal_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Open with Windows" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                    <Button x:Name="CloseVideoButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26"
                            ToolTip="Close the video: it stops, the file is free again, and OpusHC is empty (the position is kept for the next time)"
                            Click="CloseVideo_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Close video" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="FileText" Margin="16,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>

        <!-- The picture. A click plays / pauses, a double-click switches full screen, the wheel sets the volume. -->
        <Grid x:Name="Stage" Grid.Row="1" Background="Black" ClipToBounds="True"
              MouseLeftButtonDown="Stage_MouseLeftButtonDown" MouseWheel="Stage_MouseWheel" MouseMove="Stage_MouseMove"
              AllowDrop="True" Drop="Stage_Drop" DragOver="Stage_DragOver">
            <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.LayoutTransform>
                    <ScaleTransform x:Name="AspectScale" ScaleX="1" />
                </Image.LayoutTransform>
            </Image>
            <TextBlock x:Name="StageText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="40"
                       Text="Double-click a video in the explorer, or drop one here." />
            <!-- "Resumed at 12:34" for a few seconds. -->
            <Border x:Name="Toast" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,7"
                    Background="#D0202020" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="13" />
            </Border>

            <!-- VLC's engine is not there yet: the full explanation and Download, shown in the view until it is downloaded
                 (why it is needed, the exact address it comes from, the exact folder it goes to, nothing installed). -->
            <Border x:Name="EnginePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" Margin="30"
                    Padding="24,20" Background="{StaticResource WindowBackgroundBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Visibility="Collapsed">
                <Border.Resources>
                    <Style x:Key="EngineLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource GroupChevronBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Margin" Value="0,14,0,3" />
                    </Style>
                    <Style x:Key="EngineText" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style x:Key="EnginePath" TargetType="TextBox">
                        <Setter Property="IsReadOnly" Value="True" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </Border.Resources>
                <StackPanel>
                    <TextBlock Text="Download VLC's video engine?" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource EngineLabel}" Text="Why" />
                    <TextBlock x:Name="EngineWhy" Style="{StaticResource EngineText}" />
                    <TextBlock Style="{StaticResource EngineLabel}" Text="From where" />
                    <TextBlock x:Name="EngineFrom" Style="{StaticResource EngineText}" />
                    <TextBox x:Name="EngineUrl" Style="{StaticResource EnginePath}" Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Style="{StaticResource EngineLabel}" Text="Where it goes" />
                    <TextBlock Style="{StaticResource EngineText}" Text="Only into this folder, inside DirectoryFable's own data folder next to its program file:" />
                    <TextBox x:Name="EngineFolder" Style="{StaticResource EnginePath}" Margin="0,3,0,0" />
                    <TextBlock Style="{StaticResource EngineLabel}" Text="Your PC stays clean" />
                    <TextBlock x:Name="EngineClean" Style="{StaticResource EngineText}" />
                    <ProgressBar x:Name="EngineBar" Height="6" Margin="0,18,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                    <TextBlock x:Name="EngineStatus" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="EngineDownloadButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="160" Padding="14,6" Click="EngineDownload_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="EngineDownloadText" Text="Download" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EngineCancelButton" Content="Cancel" Margin="8,0,0,0" MinWidth="100" Visibility="Collapsed" Click="EngineCancel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Controls: the timeline (drag it: the picture follows), then the buttons and the volume. -->
        <Border x:Name="Controls" Grid.Row="2" Background="#F0161616" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="12,6,12,8" MouseMove="Controls_MouseMove">
            <StackPanel>
                <!-- Filmstrip: the whole video as small pictures, above the timeline (point at it: a bigger picture; click: jump). -->
                <Grid x:Name="StripRow" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="56" />
                    </Grid.ColumnDefinitions>
                    <local:Filmstrip x:Name="Strip" Grid.Column="1" Height="36" Margin="14,0" Cursor="Hand" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeText" Text="0:00" MinWidth="56" VerticalAlignment="Center" FontSize="13" />
                    <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            Margin="8,0" Focusable="False" ValueChanged="Timeline_ValueChanged"
                            Thumb.DragStarted="Timeline_DragStarted" Thumb.DragCompleted="Timeline_DragCompleted"
                            MouseMove="Timeline_MouseMove" MouseLeave="Timeline_MouseLeave" />
                    <TextBlock x:Name="LengthText" Grid.Column="2" Text="0:00" MinWidth="56" TextAlignment="Right" VerticalAlignment="Center"
                               FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                    <!-- The time under the mouse, above the timeline. -->
                    <Popup x:Name="HoverPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=Timeline}" Placement="Relative"
                           AllowsTransparency="True" IsHitTestVisible="False">
                        <Border Background="#E0202020" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="4">
                            <StackPanel>
                                <Image x:Name="HoverImage" Width="240" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="HoverText" FontSize="12" HorizontalAlignment="Center" Margin="2,2,2,0" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <DockPanel Margin="0,4,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Style="{StaticResource SubtleButton}" Padding="8,3" ToolTip="Previous video in the folder (Page Up)" Click="Previous_Click">
                            <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource SubtleButton}" Padding="10,3" Margin="2,0" ToolTip="Play / pause (Space)" Click="Play_Click">
                            <TextBlock x:Name="PlayIcon" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18" />
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Padding="8,3" ToolTip="Next video in the folder (Page Down)" Click="Next_Click">
                            <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                        </Button>
                        <TextBlock x:Name="CountText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" x:Name="FullScreenButton" Style="{StaticResource SubtleButton}" Padding="8,3" Margin="10,0,0,0"
                            ToolTip="Full screen (F or double-click; Esc leaves)" Click="FullScreen_Click">
                        <TextBlock x:Name="FullScreenIcon" Text="&#xE740;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="MuteButton" Style="{StaticResource SubtleButton}" Padding="8,3" ToolTip="Mute (M)" Click="Mute_Click">
                            <TextBlock x:Name="MuteIcon" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" Margin="4,0"
                                IsMoveToPointEnabled="True" Focusable="False" ValueChanged="Volume_ValueChanged" />
                        <TextBlock x:Name="VolumeText" Text="80 %" MinWidth="40" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Settings page: covers the picture and the controls while open. -->
        <views:OpusPlayerSettingsView x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</UserControl>
