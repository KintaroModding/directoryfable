<UserControl x:Class="DirectoryFable.Views.AstraViewerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13"
             Foreground="{StaticResource ListTextBrush}"
             Background="{StaticResource WindowBackgroundBrush}">
    <!-- AstraViewer settings: only the viewer's own settings. Saved at once. -->
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource GroupChevronBrush}" />
            <Setter Property="Margin" Value="0,26,0,6" />
        </Style>
        <Style x:Key="SettingHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,24,40,40" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close (Esc)" MinWidth="100" VerticalAlignment="Center" Click="Close_Click" />
                <TextBlock Text="AstraViewer settings" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="SaveStatus" Style="{StaticResource SettingHelp}" Margin="0,6,0,0"
                       Text="Changes are saved at once to settings.json." />

            <TextBlock Style="{StaticResource SectionTitle}" Text="View" />

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Start zoom" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="How a newly shown image starts. Fit: the whole image in the window (small images are not enlarged). Actual size: one image pixel per screen pixel. F and 1 switch while viewing." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton x:Name="ZoomFit" Content="Fit into the window" GroupName="Zoom" Checked="Zoom_Checked" />
                        <RadioButton x:Name="ZoomActual" Content="Actual size (100 %)" GroupName="Zoom" Margin="0,6,0,0" Checked="Zoom_Checked" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Background" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="The area around the image. A light background helps with dark images and black logos." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton x:Name="BackDark" Content="Dark" GroupName="Back" Checked="Background_Checked" />
                        <RadioButton x:Name="BackBlack" Content="Black" GroupName="Back" Margin="0,6,0,0" Checked="Background_Checked" />
                        <RadioButton x:Name="BackLight" Content="Light" GroupName="Back" Margin="0,6,0,0" Checked="Background_Checked" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Transparency" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="A gray checkerboard behind images with transparent parts (PNG, GIF, ICO, WebP)." />
                    </StackPanel>
                    <CheckBox x:Name="CheckerBox" Grid.Column="1" Content="Show a checkerboard behind transparent parts" VerticalAlignment="Center"
                              Checked="Checker_Changed" Unchecked="Checker_Changed" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Thumbnail size" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="The thumbnails of the folder's images below the image. Applies at once." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton x:Name="ThumbSmall" Content="Small" GroupName="Thumb" Checked="ThumbSize_Checked" />
                        <RadioButton x:Name="ThumbMedium" Content="Medium" GroupName="Thumb" Margin="0,6,0,0" Checked="ThumbSize_Checked" />
                        <RadioButton x:Name="ThumbLarge" Content="Large" GroupName="Thumb" Margin="0,6,0,0" Checked="ThumbSize_Checked" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="History" />

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Images in the history" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="The list on the left keeps this many opened images (10 to 1000), the newest at the top. Clearing it does not touch the image files." />
                    </StackPanel>
                    <ComboBox x:Name="HistorySizeBox" Grid.Column="1" Width="110" VerticalAlignment="Center" IsEditable="True"
                              SelectionChanged="HistorySize_Changed" LostKeyboardFocus="HistorySize_LostFocus" KeyDown="HistorySize_KeyDown" />
                    <Button Grid.Column="2" Content="Clear history..." MinWidth="110" Padding="12,0" Margin="12,0,0,0" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Click="ClearHistory_Click" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Open from the explorer" />

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.RowSpan="3" Margin="0,0,24,0">
                        <TextBlock Text="Double-click opens in AstraViewer" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="A double-click (or Enter) on these types in DirectoryFable opens them here: images and PDF (.pdf). Only inside DirectoryFable: the Windows defaults are not changed. The list also decides which files show in the thumbnail strip. HEIC and AVIF work only with the matching Windows codecs installed." />
                    </StackPanel>
                    <CheckBox x:Name="OpensTypes" Grid.Column="1" Content="Open these types in AstraViewer"
                              Checked="OpensTypes_Changed" Unchecked="OpensTypes_Changed" />
                    <TextBox x:Name="TypesBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" MinHeight="0" Height="60"
                             Padding="6,4" TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top"
                             LostKeyboardFocus="TypesBox_LostFocus" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Default list" MinWidth="110" Click="TypesDefault_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Keys and mouse" />
            <TextBlock Style="{StaticResource SettingHelp}" LineHeight="20"
                       Text="Left / Right (or the mouse side buttons): previous / next image of the folder. Home / End: first / last. Mouse wheel: zoom at the mouse. Drag: move a zoomed image. Double-click: fit / 100 %. F: fit. 1: 100 %. + / -: zoom. R / Shift+R: rotate the view (the file is not changed). Ctrl+C: copy the image. F5: read the folder again." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
