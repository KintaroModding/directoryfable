<UserControl x:Class="DirectoryFable.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DirectoryFable.Views"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}"
             Foreground="{StaticResource ListTextBrush}"
             Background="{StaticResource WindowBackgroundBrush}"
             PreviewKeyDown="View_PreviewKeyDown">
    <!-- SonnetSearch: name search over whole drives (the drive's file table when run as administrator)
         or a folder tree; filters by type, size and date (also "since the time mark"). -->
    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,0,6,0" />
        </Style>
        <!-- The filter lists as flat fields, as in GemmaChat's bar (FieldComboBox in Themes/Controls.xaml). -->
        <Style x:Key="FilterBox" TargetType="ComboBox" BasedOn="{StaticResource FieldComboBox}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Drive toggle: lit while the drive is searched. -->
        <Style x:Key="DriveToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3A54" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GroupChevronBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search line: Reset | Search | text | match case, regular expression | time mark. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Height="28" Padding="10,0" Margin="0,0,4,0"
                        ToolTip="Reset: empty text, all filters back to &quot;any&quot; (places and the mark stay)" Click="Reset_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Reset" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SearchButton" DockPanel.Dock="Left" Margin="0,0,8,0" Height="28" Padding="12,0" MinWidth="0"
                        ToolTip="Read the places again and search (Enter, F5)" Click="Search_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Search" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="MarkButton" Style="{StaticResource SubtleButton}" Padding="8,2" Height="26"
                            ToolTip="Set the time mark to now: &quot;Since the mark&quot; then shows only what changed after it"
                            Click="SetMark_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Set mark" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="MarkText" Margin="6,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Button x:Name="ClearMarkButton" Style="{StaticResource SubtleButton}" Width="22" Height="22" Padding="0"
                            ToolTip="Remove the time mark" Click="ClearMark_Click">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                </StackPanel>
                <ToggleButton x:Name="RegexToggle" DockPanel.Dock="Right" Style="{StaticResource SearchOptionToggle}" Width="28" Height="26"
                              Content=".*" ToolTip="Regular expression" Checked="Option_Changed" Unchecked="Option_Changed" />
                <ToggleButton x:Name="CaseToggle" DockPanel.Dock="Right" Style="{StaticResource SearchOptionToggle}" Width="28" Height="26"
                              Margin="6,0,0,0" Content="Aa" ToolTip="Match case" Checked="Option_Changed" Unchecked="Option_Changed" />
                <Grid>
                    <TextBox x:Name="QueryBox" Style="{StaticResource FieldTextBox}" FontSize="13"
                             TextChanged="QueryBox_TextChanged" />
                    <TextBlock x:Name="QueryHint" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Name: words in any order, *.sav, save??.dat, &quot;quoted text&quot;  -  Enter reads the places again" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Where: drive toggles, ticked folders (chips), and the location list with a folder tree. -->
        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <WrapPanel>
                <TextBlock Text="In" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ItemsControl x:Name="DriveBar" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl x:Name="FolderChips" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,0" Height="24" Padding="8,0,2,0" Background="#1F3A54"
                                    BorderBrush="{StaticResource GroupChevronBrush}" BorderThickness="1" ToolTip="{Binding Path}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Path}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource SubtleButton}" Width="20" Height="20" Padding="0" Margin="6,0,0,0"
                                            ToolTip="Do not search this folder" Click="ChipRemove_Click">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ToggleButton x:Name="LocationsButton" Style="{StaticResource BarToggleButton}" Padding="8,2" Height="24" Margin="2,0,0,0"
                              ToolTip="Choose drives and folders (a folder tree)" Click="Locations_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource GroupChevronBrush}" />
                        <TextBlock Text="Places" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="6,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="LocationsPopup" PlacementTarget="{Binding ElementName=LocationsButton}" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" Closed="LocationsPopup_Closed">
                    <Border Background="#202020" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="0,0,0,8" Width="720">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6" Color="Black" />
                        </Border.Effect>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,8,10,0">
                                <Button Content="Add path..." MinWidth="120" Click="AddPath_Click"
                                        ToolTip="Add a folder (also network paths) to the list, ticked" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Tick drives and folders to search them. Open a row to tick its subfolders." />
                            </StackPanel>
                            <Grid DockPanel.Dock="Top" Height="24" Background="{StaticResource ColumnHeaderBackgroundBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" Margin="34,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ColumnHeaderTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Total Size" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource ColumnHeaderTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Free Space" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource ColumnHeaderTextBrush}" />
                                <TextBlock Grid.Column="3" Text="% Free Space" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource ColumnHeaderTextBrush}" />
                            </Grid>
                            <TreeView x:Name="LocationTree" MaxHeight="460" MinHeight="120" Background="Transparent" BorderThickness="0" Padding="0,4"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="MinHeight" Value="26" />
                                        <Setter Property="Padding" Value="2,0" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid x:Name="Row" Height="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" MinWidth="0" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Width="100" Text="{Binding TotalText}" TextAlignment="Right" VerticalAlignment="Center"
                                                       Visibility="{Binding IsTopLevel, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Grid.Column="2" Width="100" Text="{Binding FreeText}" TextAlignment="Right" VerticalAlignment="Center"
                                                       Visibility="{Binding IsTopLevel, Converter={StaticResource BoolToVisibility}}" />
                                            <Grid Grid.Column="3" Width="122" Height="16" Margin="14,0,0,0"
                                                  Visibility="{Binding IsTopLevel, Converter={StaticResource BoolToVisibility}}">
                                                <Border Background="#333333" BorderBrush="#555555" BorderThickness="1" />
                                                <Rectangle Width="{Binding FreeBarWidth}" HorizontalAlignment="Left" Margin="1" Fill="#3DAA4E" />
                                                <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                            </Grid>
                                            <Button Grid.Column="4" Style="{StaticResource SubtleButton}" Width="22" Height="20" Padding="0" Margin="6,0,0,0"
                                                    ToolTip="Take this folder off the list" Click="RemovePinned_Click"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" />
                                            </Button>
                                        </Grid>
                                        <HierarchicalDataTemplate.Triggers>
                                            <!-- Top level rows: fixed width so the numbers line up under the headers. -->
                                            <DataTrigger Binding="{Binding IsTopLevel}" Value="True">
                                                <Setter TargetName="Row" Property="Width" Value="650" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Border>
                </Popup>
            </WrapPanel>
        </Border>

        <!-- Filters. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,4,8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FilterLabel}" Text="Type" />
                <ComboBox x:Name="TypeBox" Style="{StaticResource FilterBox}" Width="130" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Files" />
                    <ComboBoxItem Content="Folders" />
                    <ComboBoxItem Content="Images" />
                    <ComboBoxItem Content="Text files" />
                    <ComboBoxItem Content="Extensions..." />
                </ComboBox>
                <TextBox x:Name="ExtensionsBox" Style="{StaticResource FieldTextBox}" Width="160" Margin="6,0,0,0"
                         Visibility="Collapsed" ToolTip=".sav .dat .ini (separated by spaces)"
                         TextChanged="Extensions_TextChanged" />
                <TextBlock Style="{StaticResource FilterLabel}" Text="Size" />
                <ComboBox x:Name="SizeBox" Style="{StaticResource FilterBox}" Width="150" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Any" />
                    <ComboBoxItem Content="Empty (0 bytes)" />
                    <ComboBoxItem Content="Smaller than 1 MB" />
                    <ComboBoxItem Content="At least 1 MB" />
                    <ComboBoxItem Content="At least 10 MB" />
                    <ComboBoxItem Content="At least 100 MB" />
                    <ComboBoxItem Content="At least 1 GB" />
                </ComboBox>
                <TextBlock Style="{StaticResource FilterLabel}" Text="Date" />
                <ComboBox x:Name="DateColumnBox" Style="{StaticResource FilterBox}" Width="160" SelectionChanged="Filter_Changed"
                          ToolTip="Which date the time filter looks at">
                    <ComboBoxItem Content="Any of the three" />
                    <ComboBoxItem Content="Last Modified" />
                    <ComboBoxItem Content="Creation Date" />
                    <ComboBoxItem Content="Last Accessed" />
                </ComboBox>
                <ComboBox x:Name="RangeBox" Style="{StaticResource FilterBox}" Width="160" Margin="6,0,0,0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Any time" />
                    <ComboBoxItem Content="Last 10 minutes" />
                    <ComboBoxItem Content="Last hour" />
                    <ComboBoxItem Content="Today" />
                    <ComboBoxItem Content="Last 7 days" />
                    <ComboBoxItem Content="Last 30 days" />
                    <ComboBoxItem x:Name="SinceMarkItem" Content="Since the mark" />
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Results: the same row look as the explorer; click a header to sort. The list's own
             vertical scroll bar is hidden: ResultScrubber on the right stands in for it. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="Results" BorderThickness="0" Background="{StaticResource ListBackgroundBrush}"
                      ItemContainerStyle="{StaticResource AlternatingFileRowStyle}" AlternationCount="2" SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item" ScrollViewer.IsDeferredScrollingEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      MouseDoubleClick="Results_MouseDoubleClick" MouseRightButtonUp="Results_MouseRightButtonUp"
                      PreviewMouseLeftButtonDown="Results_PreviewMouseLeftButtonDown" PreviewMouseMove="Results_PreviewMouseMove">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                        <!-- Row number in the shown order (not a sort column). -->
                        <GridViewColumn Width="64">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Number" Content="#" Style="{StaticResource ColumnHeaderRightStyle}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Number}" TextAlignment="Right" Foreground="{StaticResource EditorLineNumberBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="300">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name" Content="Name" Click="Header_Click" Style="{StaticResource ColumnHeaderStyle}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="480">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Path" Content="Containing Path" Click="Header_Click" Style="{StaticResource ColumnHeaderStyle}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size" Content="Size" Click="Header_Click" Style="{StaticResource ColumnHeaderRightStyle}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="150">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Modified" Content="Last Modified" Click="Header_Click" Style="{StaticResource ColumnHeaderStyle}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Modified}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="150">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Accessed" Content="Last Accessed" Click="Header_Click" Style="{StaticResource ColumnHeaderStyle}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Accessed}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="150">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Created" Content="Creation Date" Click="Header_Click" Style="{StaticResource ColumnHeaderStyle}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Created}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="150">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Type" Content="Type" Click="Header_Click" Style="{StaticResource ColumnHeaderStyle}" />
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <local:ResultScrubber x:Name="Scrubber" Grid.Column="1" Width="16" />
        </Grid>
        <TextBlock x:Name="EmptyText" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" IsHitTestVisible="False" TextWrapping="Wrap" Margin="40" />

        <!-- Status: how many, from where, how fast; reading progress. -->
        <Border Grid.Row="4" Height="24" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0">
                <TextBlock x:Name="AgeText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
