<Window x:Class="DirectoryFable.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties"
        Width="600" Height="680" MinWidth="380" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ListTextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <!-- Own file properties window: the content of Windows' "Details" tab,
         grouped like there. Values can be selected and copied. -->
    <Window.Resources>
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Bare text: no box, no focus underline; still selectable. -->
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <!-- Header: icon, name, folder. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Image x:Name="ItemIcon" Width="16" Height="16" Margin="0,3,10,0" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel>
                <TextBox x:Name="ItemName" Style="{StaticResource ValueBox}" FontSize="16" FontWeight="SemiBold" />
                <TextBox x:Name="ItemFolder" Style="{StaticResource ValueBox}" FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copy all" MinWidth="100" Margin="0,0,8,0" Click="CopyAll_Click" />
            <Button Content="Close" MinWidth="100" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </StackPanel>

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Reading properties…" Margin="0,12"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Groups" Margin="0,4,8,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Section header like the Windows Details tab: name, then a fine line. -->
                                    <DockPanel Margin="0,14,0,6">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource GroupChevronBrush}"
                                                   FontSize="14" Margin="0,0,10,0" />
                                        <Rectangle Height="1" Fill="{StaticResource LineBrush}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0" />
                                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}"
                                                             Style="{StaticResource ValueBox}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
