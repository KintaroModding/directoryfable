<UserControl x:Class="DirectoryFable.Views.FavoritesBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DirectoryFable.Views"
             Height="{StaticResource FavoritesBarHeight}"
             BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FavoritesFontSize}"
             Background="{StaticResource WindowBackgroundBrush}"
             AllowDrop="True"
             DragEnter="Bar_DragOver" DragOver="Bar_DragOver" Drop="Bar_Drop"
             MouseRightButtonUp="Bar_MouseRightButtonUp"
             PreviewMouseMove="Bar_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Bar_PreviewMouseLeftButtonUp"
             LostMouseCapture="Bar_LostMouseCapture">
    <!-- Shared favorites bar. Acts on the active pane. -->
    <DockPanel Margin="4,0" LastChildFill="True">
        <Button x:Name="OverflowButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}"
                Content="&#xE76C;&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="8"
                Padding="7,0" Height="24" ToolTip="More favorites" Visibility="Collapsed"
                Click="Overflow_Click" />

        <ItemsControl x:Name="FavItems" ItemsSource="{Binding Items}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- "Desktop / Documents / Downloads": dim separators instead of button frames. -->
                    <local:OverflowPanel Gap="{StaticResource FavoritesGap}" Separator="/"
                                         SeparatorBrush="{StaticResource FavoriteSeparatorBrush}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Padding="7,1" Height="26"
                            ToolTip="{Binding ToolTip}"
                            Click="Favorite_Click"
                            PreviewMouseLeftButtonDown="Favorite_PreviewMouseLeftButtonDown"
                            PreviewMouseUp="Favorite_PreviewMouseUp"
                            AllowDrop="True"
                            DragEnter="Favorite_DragOver" DragOver="Favorite_DragOver"
                            DragLeave="Favorite_DragLeave" Drop="Favorite_Drop">
                        <!-- Faded while it is dragged to a new place. -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="Menu_Open" FontWeight="Bold" />
                                <MenuItem Header="Open in new tab" Click="Menu_OpenNewTab" />
                                <Separator />
                                <MenuItem Header="Rename..." Click="Menu_Rename" />
                                <MenuItem Header="Remove" Click="Menu_Remove" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
