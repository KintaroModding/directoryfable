<UserControl x:Class="DirectoryFable.Views.SpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DirectoryFable.Views"
             Background="{StaticResource ListBackgroundBrush}"
             Foreground="{StaticResource ListTextBrush}"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}">
    <!-- Space view: what takes the space in a folder, biggest first, with a bar per row (share of the folder). -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="SpaceTrackBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="SpaceFolderBrush" Color="#1A6FD1" />
        <SolidColorBrush x:Key="SpaceFileBrush" Color="#6A7F99" />
        <SolidColorBrush x:Key="SpaceOtherBrush" Color="#8A6BBE" />
        <SolidColorBrush x:Key="SpaceFreeBrush" Color="#DADADA" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ListRow" Height="55*" MinHeight="60" />
            <RowDefinition x:Name="SplitterRow" Height="5" />
            <RowDefinition x:Name="BlocksRow" Height="45*" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Summary: total, files, folders; at a drive root also files / other / free as one bar. -->
        <Border Grid.Row="0" Background="{StaticResource QuickBarBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="10,5,10,6">
            <DockPanel LastChildFill="True">
                <!-- The block chart below the list on / off. -->
                <ToggleButton x:Name="BlocksToggle" DockPanel.Dock="Right" Style="{StaticResource BarToggleButton}" Padding="8,2"
                              Margin="12,-2,0,0" VerticalAlignment="Top" Click="BlocksToggle_Click"
                              ToolTip="Block chart: every file and folder as a box, sized by its space">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Blocks" Foreground="{StaticResource BreadcrumbTextBrush}" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock x:Name="AgeText" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <StackPanel>
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="&#xEB05;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource GroupChevronBrush}" />
                        <Run x:Name="TotalRun" FontWeight="SemiBold" Text="" />
                        <Run x:Name="CountsRun" Foreground="{StaticResource SecondaryTextBrush}" Text="" />
                    </TextBlock>
                    <StackPanel x:Name="DrivePanel" Visibility="Collapsed" Margin="0,5,0,0">
                        <Grid x:Name="DriveBar" Height="8" Width="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FilesPart" Width="1*" />
                                <ColumnDefinition x:Name="OtherPart" Width="0*" />
                                <ColumnDefinition x:Name="FreePart" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SpaceFolderBrush}" />
                            <Border Grid.Column="1" Background="{StaticResource SpaceOtherBrush}" />
                            <Border Grid.Column="2" Background="{StaticResource SpaceFreeBrush}" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}">
                            <Run Text="&#x25A0;" Foreground="{StaticResource SpaceFolderBrush}" /> <Run x:Name="FilesRun" Text="" />
                            <Run Text="     " /><Run x:Name="OtherMark" Text="&#x25A0;" Foreground="{StaticResource SpaceOtherBrush}" /> <Run x:Name="OtherRun" Text="" />
                            <Run Text="     " /><Run Text="&#x25A0;" Foreground="{StaticResource SpaceFreeBrush}" /> <Run x:Name="FreeRun" Text="" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ListView Grid.Row="1" x:Name="List" BorderThickness="0" Background="{StaticResource ListBackgroundBrush}"
                  ItemContainerStyle="{StaticResource AlternatingFileRowStyle}" AlternationCount="2" SelectionMode="Extended"
                  IsTextSearchEnabled="False" FocusVisualStyle="{x:Null}"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  GridViewColumnHeader.Click="Header_Click"
                  MouseDoubleClick="List_MouseDoubleClick" PreviewMouseDown="List_PreviewMouseDown"
                  MouseRightButtonUp="List_MouseRightButtonUp" KeyDown="List_KeyDown">
            <ListView.View>
                <GridView x:Name="Columns" ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                    <GridViewColumn Width="340">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Name" Content="Name" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="13" Height="13" Margin="0,0,5,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="90">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Size" Content="Size" Style="{StaticResource ColumnHeaderRightStyle}" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Share of the shown folder: a bar and the percentage. -->
                    <GridViewColumn Width="190">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Share" Content="Share" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" ToolTip="{Binding ShareToolTip}">
                                    <TextBlock DockPanel.Dock="Right" Width="52" Text="{Binding ShareText}" TextAlignment="Right"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <Grid Height="10" VerticalAlignment="Center" Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ShareWidth}" />
                                            <ColumnDefinition Width="{Binding RestWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" Background="{StaticResource SpaceTrackBrush}" />
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SpaceFileBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SpaceFolderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Files" Content="Files" Style="{StaticResource ColumnHeaderRightStyle}" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FilesText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="70">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Folders" Content="Folders" Style="{StaticResource ColumnHeaderRightStyle}" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FoldersText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="150">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Modified" Content="Modified" Style="{StaticResource ColumnHeaderRightStyle}" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ModifiedText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter x:Name="Splitter" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
                      Background="{StaticResource LineDarkBrush}" DragCompleted="Splitter_DragCompleted" />

        <!-- Block chart (Views/Treemap.cs) and, below it, what the mouse points at. -->
        <DockPanel x:Name="BlocksPanel" Grid.Row="3">
            <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" Padding="8,3" TextTrimming="CharacterEllipsis"
                       Background="{StaticResource QuickBarBrush}" Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Point at a box to see what it is. Click: select it in the list; double-click: open." />
            <local:Treemap x:Name="Blocks" Margin="2" />
        </DockPanel>

        <!-- Reading, errors, an empty folder. -->
        <TextBlock Grid.Row="1" x:Name="MessageText" Margin="20,48,20,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                   TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                   IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
