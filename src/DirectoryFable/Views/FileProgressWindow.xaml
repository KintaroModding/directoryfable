<Window x:Class="DirectoryFable.Views.FileProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copying" Width="810" SizeToContent="Height" ResizeMode="CanMinimize"
        ShowInTaskbar="True" WindowStartupLocation="Manual"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ListTextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <!-- DirectoryFable's copy / move progress (fed by the Windows copy engine, see Shell/OperationProgress.cs). -->
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="HeadText" FontSize="17" FontWeight="SemiBold" Text="Copying" />
        <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis">
            <Run Text="From " Foreground="{StaticResource SecondaryTextBrush}" /><Run x:Name="FromRun" Foreground="{StaticResource GroupChevronBrush}" />
            <Run x:Name="ToLabel" Text="  to " Foreground="{StaticResource SecondaryTextBrush}" /><Run x:Name="ToRun" Foreground="{StaticResource GroupChevronBrush}" />
        </TextBlock>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center" />
            <TextBlock x:Name="PercentText" Grid.Column="1" Margin="12,0,0,0" MinWidth="44" TextAlignment="Right"
                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Item" />
            <TextBlock x:Name="ItemText" Grid.Column="1" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Margin="0,6,14,0" Style="{StaticResource Label}" Text="Speed" />
            <TextBlock x:Name="SpeedText" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" />
            <TextBlock Grid.Row="2" Margin="0,6,14,0" Style="{StaticResource Label}" Text="Time" />
            <TextBlock x:Name="TimeText" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" Margin="0,6,14,0" Style="{StaticResource Label}" Text="Remaining" />
            <TextBlock x:Name="ItemsText" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" />
            <TextBlock Grid.Row="4" Margin="0,6,14,0" Style="{StaticResource Label}" Text="Done" />
            <TextBlock x:Name="DoneText" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" />
        </Grid>

        <!-- Details: the full paths, slid open below by the Details button (right-click a path: copy it). -->
        <Border x:Name="DetailsPanel" Margin="0,14,0,0" Padding="12,8" Visibility="Collapsed" ClipToBounds="True"
                Background="{StaticResource ListBackgroundBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="DetailsScale" ScaleY="0" />
            </Border.LayoutTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="From" />
                <TextBlock x:Name="FromPathText" Grid.Column="1" TextWrapping="Wrap" MouseRightButtonUp="Path_MouseRightButtonUp" Background="Transparent" />
                <TextBlock x:Name="ToPathLabel" Grid.Row="1" Margin="0,6,14,0" Style="{StaticResource Label}" Text="To" />
                <TextBlock x:Name="ToPathText" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" MouseRightButtonUp="Path_MouseRightButtonUp" Background="Transparent" />
                <TextBlock Grid.Row="2" Margin="0,6,14,0" Style="{StaticResource Label}" Text="Item" />
                <TextBlock x:Name="ItemPathText" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" MouseRightButtonUp="Path_MouseRightButtonUp" Background="Transparent" />
            </Grid>
        </Border>

        <DockPanel Margin="0,20,0,0">
        <ToggleButton x:Name="DetailsButton" DockPanel.Dock="Left" Style="{StaticResource BarToggleButton}" Padding="8,4" VerticalAlignment="Center"
                      Click="Details_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DetailsChevron" FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE70D;" Margin="0,2,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Details" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </ToggleButton>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PauseButton" MinWidth="100" Click="Pause_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PauseIcon" FontFamily="{StaticResource IconFont}" Text="&#xE769;" Margin="0,1,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="PauseText" Text="Pause" />
                </StackPanel>
            </Button>
            <Button MinWidth="100" Margin="8,0,0,0" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" Margin="0,1,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>
        </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
