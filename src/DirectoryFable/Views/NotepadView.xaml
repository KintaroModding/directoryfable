<UserControl x:Class="DirectoryFable.Views.NotepadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:views="clr-namespace:DirectoryFable.Views"
             xmlns:editor="clr-namespace:DirectoryFable.Editor"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}"
             Foreground="{StaticResource ListTextBrush}"
             Background="{StaticResource WindowBackgroundBrush}"
             PreviewKeyDown="View_PreviewKeyDown"
             AllowDrop="True" PreviewDragEnter="View_PreviewDragOver" PreviewDragOver="View_PreviewDragOver"
             PreviewDrop="View_PreviewDrop">
    <!-- Notepad#: own bar, vertical file list on the left, editor on the right. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bar: same size and look as the explorer's action bar. -->
        <Border Grid.Row="0" Height="{StaticResource FavoritesBarHeight}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource WindowBackgroundBrush}">
            <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center" TextElement.FontSize="{StaticResource FavoritesFontSize}">
                <ToggleButton x:Name="SettingsButton" Style="{StaticResource BarToggleButton}" Padding="7,1" Height="26"
                              ToolTip="Notepad# settings" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                <Button Style="{StaticResource SubtleButton}" Padding="7,1" Height="26" ToolTip="New empty file (Ctrl+N)" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="New" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Padding="7,1" Height="26" ToolTip="Open files (Ctrl+O)" Click="Open_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Open" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26" ToolTip="Save (Ctrl+S)" Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                <ToggleButton x:Name="WrapButton" Style="{StaticResource BarToggleButton}" Padding="7,1" Height="26"
                              ToolTip="Word wrap: long lines wrap at the right edge (Alt+Z)" Click="Wrap_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE751;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Word wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                <!-- Language menu: letters A, B, C ... with the languages inside (like Notepad++). -->
                <Button x:Name="LanguageButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26"
                        ToolTip="Syntax highlighting of this file" Click="Language_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Language: " VerticalAlignment="Center" />
                        <TextBlock x:Name="LanguageText" Text="Normal Text" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="6,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="260" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Open files as a vertical list in groups: own groups and automatic ones (by type or
                 folder). Group headers look like the explorer's group dividers. Rows are built in
                 code (NotepadView.Groups.cs): headers and files of open groups. -->
            <ListBox x:Name="FileList" Grid.Column="0" Background="{StaticResource TreeBackgroundBrush}" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="FileList_SelectionChanged" PreviewMouseUp="FileList_PreviewMouseUp"
                     MouseRightButtonUp="FileList_MouseRightButtonUp"
                     PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="FileList_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                     LostMouseCapture="FileList_LostMouseCapture">
                <ListBox.Resources>
                    <!-- Group header: chevron, name, (count) while collapsed, a fine line. -->
                    <DataTemplate DataType="{x:Type editor:EditorGroup}">
                        <DockPanel Background="Transparent" ToolTip="{Binding ToolTip}">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       Foreground="{StaticResource GroupChevronBrush}" Margin="0,2,7,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE70D;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="&#xE76C;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="400">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
                                        <Style.Triggers>
                                            <!-- Automatic groups (by type / folder) are a little quieter than own groups. -->
                                            <DataTrigger Binding="{Binding IsAuto}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BreadcrumbTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CountText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="10,1,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>

                    <!-- Divider between own and automatic groups: a dashed line over the full width. -->
                    <DataTemplate DataType="{x:Type views:NotepadView+GroupDivider}">
                        <Grid x:Name="DividerRow" Height="3" Margin="0,2,0,0" VerticalAlignment="Center">
                            <Line X1="0" Y1="1" Y2="1" X2="{Binding ActualWidth, ElementName=DividerRow}"
                                  Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1" StrokeDashArray="4 3"
                                  SnapsToDevicePixels="True" />
                        </Grid>
                    </DataTemplate>

                    <!-- File: disk icon (blue saved, red changed), name, extension; indented below its header. -->
                    <DataTemplate DataType="{x:Type editor:EditorDocument}">
                        <Grid ToolTip="{Binding ToolTip}" Margin="16,0,0,0">
                            <!-- Faded while it is dragged to a new place (its picture follows the mouse). -->
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Default: a save symbol (red with unsaved changes). A chosen icon (right-click, Icon):
                                 its picture, or its symbol while the picture is missing; a red dot for unsaved changes. -->
                            <Grid Width="16" Height="16" Margin="0,1,7,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource GroupChevronBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Image Source="{Binding Icon.Image}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Icon.Glyph}" Foreground="{Binding Icon.Brush}" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon.HasImage}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-1"
                                         Fill="{StaticResource ErrorTextBrush}" Stroke="{StaticResource ListBackgroundBrush}" StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasIcon}" Value="True" />
                                                        <Condition Binding="{Binding IsDirty}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <!-- A file that is gone: name and extension red, plus a dismiss button. -->
                            <TextBlock Grid.Column="1" Text="{Binding Stem}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding Extension}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="3" Margin="6,0,0,0" Padding="4,0" Height="18"
                                    Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                    Foreground="{StaticResource ErrorTextBrush}" ToolTip="Dismiss: remove this entry (the file is gone)"
                                    Click="RowDismiss_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TreeSelectedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Header rows: a bit taller, a gap above, never selected or focused. -->
                            <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                <Setter Property="Height" Value="26" />
                                <Setter Property="Padding" Value="6,4,6,0" />
                                <Setter Property="Focusable" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}" />

            <DockPanel Grid.Column="2">
                <!-- Status line: position, size, encoding, line endings, language. -->
                <Border DockPanel.Dock="Bottom" Height="22" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                        Background="{StaticResource WindowBackgroundBrush}">
                    <DockPanel Margin="8,0">
                        <TextBlock x:Name="MessageText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    </DockPanel>
                </Border>
                <!-- Just above line 1: the shown file's full path; right-click: copy it, show it in the explorer. -->
                <Border DockPanel.Dock="Top" Height="24" Background="{StaticResource EditorBackgroundBrush}"
                        BorderBrush="{StaticResource LineDarkBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding Visibility, ElementName=Editor}">
                    <TextBlock x:Name="PathText" Margin="10,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}" Background="Transparent"
                               MouseRightButtonUp="PathText_MouseRightButtonUp" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Text | minimap | scroll bar, like VS Code: the editor's own vertical scroll bar
                         is hidden (it still scrolls); EditorScrollBar on the right stands in for it. -->
                    <editor:NotepadTextEditor x:Name="Editor" ShowLineNumbers="True" Visibility="Collapsed"
                                       Background="{StaticResource EditorBackgroundBrush}"
                                       Foreground="{StaticResource EditorTextBrush}"
                                       LineNumbersForeground="{StaticResource EditorLineNumberBrush}"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                                       Padding="4,2,0,0" />
                    <!-- Minimap (like VS Code): click = jump, drag the box = scroll. -->
                    <editor:Minimap x:Name="Minimap" Grid.Column="1" Width="165"
                                    Visibility="{Binding Visibility, ElementName=Editor}" />
                    <ScrollBar x:Name="EditorScrollBar" Grid.Column="2" Orientation="Vertical" Visibility="Collapsed"
                               Scroll="EditorScrollBar_Scroll" />
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13">
                        No file is open.<LineBreak />New file: Ctrl+N. Open one here (Ctrl+O), drop files here, or in the explorer:<LineBreak />right-click a file, "Open in Notepad#", or Ctrl+E.
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- Notepad# settings page: covers everything below the bar while open. -->
        <views:NotepadSettingsView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</UserControl>
