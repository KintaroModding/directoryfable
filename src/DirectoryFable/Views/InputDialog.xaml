<Window x:Class="DirectoryFable.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DirectoryFable"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ListTextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource UiFontSize}">
    <StackPanel Margin="16" MinWidth="320">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" />
        <TextBox x:Name="InputBox" MinHeight="0" Height="26" Padding="4,0" VerticalContentAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
