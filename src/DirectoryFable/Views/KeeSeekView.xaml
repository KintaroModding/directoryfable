<UserControl x:Class="DirectoryFable.Views.KeeSeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DirectoryFable.Views"
             FontFamily="{StaticResource UiFont}" FontSize="13"
             Foreground="{StaticResource ListTextBrush}"
             Background="{StaticResource WindowBackgroundBrush}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="View_PreviewKeyDown" PreviewTextInput="View_PreviewTextInput"
             PreviewMouseDown="View_Used" PreviewMouseMove="View_Used" PreviewMouseWheel="View_Used">
    <!-- KeeSeek: passwords. Locked: one card with the master password. Open: categories on the left, the chosen
         category's entries as cards on the right, a search over all. Logic: KeeSeekView.xaml.cs. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#202020" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#262626" />
        <SolidColorBrush x:Key="SideBrush" Color="#161616" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF7A7A" />

        <!-- Row size: set from the setting keeSeekRowHeight (KeeSeekView.ApplyRowHeight); these are the 52 px values. -->
        <system:Double x:Key="RowContentHeight" xmlns:system="clr-namespace:System;assembly=System.Runtime">33</system:Double>
        <system:Double x:Key="RowAvatarSize" xmlns:system="clr-namespace:System;assembly=System.Runtime">30</system:Double>
        <CornerRadius x:Key="RowAvatarCorner">15</CornerRadius>
        <Thickness x:Key="RowPadding">12,7</Thickness>
        <Visibility x:Key="RowSubtitleVisibility">Visible</Visibility>
        <Visibility x:Key="RowAvatarVisibility">Visible</Visibility>
        <GridLength x:Key="RowAvatarColumn">44</GridLength>
        <Thickness x:Key="RowMargin">0,1,0,2</Thickness>
        <system:Double x:Key="DividerContentHeight" xmlns:system="clr-namespace:System;assembly=System.Runtime">17</system:Double>
        <Thickness x:Key="DividerPadding">12,2</Thickness>
        <system:Double x:Key="DividerTitleSize" xmlns:system="clr-namespace:System;assembly=System.Runtime">12</system:Double>
        <system:Double x:Key="RowTitleSize" xmlns:system="clr-namespace:System;assembly=System.Runtime">14</system:Double>
        <system:Double x:Key="RowFontSize" xmlns:system="clr-namespace:System;assembly=System.Runtime">13</system:Double>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Width" Value="330" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                </Trigger>
                <!-- A colored entry: its color as the frame; a divider: a slim bar in its color. -->
                <DataTrigger Binding="{Binding HasColorFrame}" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding CardBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDivider}" Value="True">
                    <Setter Property="Background" Value="{Binding DividerBrush}" />
                    <Setter Property="Padding" Value="14,6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A field that copies (or opens) on a click. -->
        <Style x:Key="CopyField" TargetType="TextBlock">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GroupChevronBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="BarIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,1,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A category row on the left: name, count; hover and selection as the lists. -->
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,8" Margin="6,1" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An entry row: rounded, hover and selection like the lists, the keyboard focus as a fine frame. -->
        <Style x:Key="EntryRowItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <!-- The entry's color: a light tint (a divider: a strong one) and a thin stripe on the left. -->
                            <Border x:Name="Bd" Background="{Binding RowBrush}" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="6" Padding="{DynamicResource RowPadding}" Margin="{DynamicResource RowMargin}">
                                <ContentPresenter />
                            </Border>
                            <Rectangle Width="3" HorizontalAlignment="Left" Margin="{DynamicResource RowMargin}" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{Binding StripeBrush}" IsHitTestVisible="False" />
                            <!-- A subtle divider under each row. -->
                            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="12,0" Fill="#2A2A2A" SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRectBrush}" />
                            </Trigger>
                            <!-- Last, so it wins: a divider always keeps its own color (no hover or selection color). -->
                            <DataTrigger Binding="{Binding IsDivider}" Value="True">
                                <Setter TargetName="Bd" Property="Padding" Value="{DynamicResource DividerPadding}" />
                                <Setter TargetName="Bd" Property="Background" Value="{Binding DividerBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EntryRowTemplate">
            <Grid Background="Transparent" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <!-- A divider: only its title, as high as an entry (a double-click or Enter edits it). -->
                <DockPanel Height="{DynamicResource DividerContentHeight}" Visibility="{Binding IsDivider, Converter={StaticResource BoolToVisibility}}"
                           ClipToBounds="True" ToolTip="Divider (double-click to edit)">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource DividerTitleSize}" Foreground="White"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                </DockPanel>
            <Grid Height="{DynamicResource RowContentHeight}" Background="Transparent"
                  ClipToBounds="True" TextElement.FontSize="{DynamicResource RowFontSize}"
                  Visibility="{Binding IsEntry, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource RowAvatarColumn}" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Border Width="{DynamicResource RowAvatarSize}" Height="{DynamicResource RowAvatarSize}" CornerRadius="{DynamicResource RowAvatarCorner}"
                        Background="{Binding Avatar}" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="{DynamicResource RowAvatarVisibility}">
                    <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource RowTitleSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="8,2,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" ToolTip="{Binding Entry.Notes}"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Border Visibility="{DynamicResource RowSubtitleVisibility}">
                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding ShowCategory, Converter={StaticResource BoolToVisibility}}" />
                    </Border>
                </StackPanel>
                <DockPanel Grid.Column="2" Margin="0,0,12,0" Visibility="{Binding HasUser, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE77B;" />
                    <TextBlock Style="{StaticResource CopyField}" Text="{Binding UserName}"
                               ToolTip="Click to copy the user name (Ctrl+B)" MouseLeftButtonUp="CopyUser_Click" />
                </DockPanel>
                <DockPanel Grid.Column="3" Margin="0,0,12,0" Visibility="{Binding HasPassword, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE8D7;" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="5,1" VerticalAlignment="Center"
                            ToolTip="Show / hide the password" Click="Reveal_Click">
                        <TextBlock Text="{Binding RevealIcon}" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                    <TextBlock Style="{StaticResource CopyField}" Text="{Binding PasswordText}" FontFamily="Consolas"
                               ToolTip="Click to copy the password (Ctrl+C)" MouseLeftButtonUp="CopyPassword_Click" />
                </DockPanel>
                <DockPanel Grid.Column="4" Margin="0,0,12,0" Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE71B;" />
                    <TextBlock Style="{StaticResource CopyField}" Text="{Binding Url}"
                               ToolTip="Click to open it in the browser (Ctrl+U)" MouseLeftButtonUp="OpenUrl_Click" />
                </DockPanel>
                <TextBlock Grid.Column="5" Text="{Binding ChangedShort}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}" ToolTip="{Binding ChangedText}" />
                <Button Grid.Column="6" Style="{StaticResource SubtleButton}" Padding="6,3" VerticalAlignment="Center"
                        ToolTip="Edit (Enter or a double-click)" Click="EditCard_Click">
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
            </Grid>
            </Grid>
        </DataTemplate>

        <!-- An entry card. -->
        <DataTemplate DataType="{x:Type local:KeeSeekView+EntryCard}">
            <Border Style="{StaticResource Card}" MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{Binding Avatar}"
                                Visibility="{Binding IsEntry, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="6,3" VerticalAlignment="Top"
                                ToolTip="Edit (or double-click the card)" Click="EditCard_Click">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <StackPanel Margin="12,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                                       Visibility="{Binding ShowCategory, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0" Visibility="{Binding HasUser, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE77B;" />
                        <TextBlock Style="{StaticResource CopyField}" Text="{Binding UserName}"
                                   ToolTip="Click to copy the user name" MouseLeftButtonUp="CopyUser_Click" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding HasPassword, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE8D7;" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="5,1"
                                ToolTip="Show / hide the password" Click="Reveal_Click">
                            <TextBlock Text="{Binding RevealIcon}" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Button>
                        <TextBlock Style="{StaticResource CopyField}" Text="{Binding PasswordText}" FontFamily="Consolas"
                                   ToolTip="Click to copy the password" MouseLeftButtonUp="CopyPassword_Click" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldIcon}" Text="&#xE71B;" />
                        <TextBlock Style="{StaticResource CopyField}" Text="{Binding Url}"
                                   ToolTip="Click to open it in the browser" MouseLeftButtonUp="OpenUrl_Click" />
                    </DockPanel>
                    <TextBlock Text="{Binding NotesPreview}" Margin="22,8,0,0" FontSize="12" TextWrapping="Wrap" MaxHeight="34"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}"
                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ChangedText}" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                               Visibility="{Binding IsEntry, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bar: same size and look as the other views'. -->
        <Border Grid.Row="0" Height="{StaticResource FavoritesBarHeight}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Background="{StaticResource WindowBackgroundBrush}">
            <DockPanel Margin="4,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="{StaticResource FavoritesFontSize}">
                    <ToggleButton x:Name="SettingsButton" Style="{StaticResource BarToggleButton}" Padding="7,1" Height="26"
                                  ToolTip="KeeSeek settings" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarIcon}" Text="&#xE713;" FontSize="14" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                    <Button x:Name="NewEntryButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26"
                            ToolTip="A new entry in the shown category (Ctrl+N)" Click="NewEntry_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarIcon}" Text="&#xE710;" />
                            <TextBlock Text="New entry" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26"
                            ToolTip="Import entries from a CSV export of another password manager" Click="Import_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarIcon}" Text="&#xE8B5;" />
                            <TextBlock Text="Import CSV" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                    <Button x:Name="LockButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26"
                            ToolTip="Lock KeeSeek now (Ctrl+L)" Click="Lock_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarIcon}" Text="&#xE72E;" />
                            <TextBlock Text="Lock" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
                    <!-- Rows (default) or cards. -->
                    <ToggleButton x:Name="RowsViewButton" Style="{StaticResource BarToggleButton}" Padding="7,1" Height="26"
                                  ToolTip="Entries as rows" Click="RowsView_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarIcon}" Text="&#xE8FD;" />
                            <TextBlock Text="Rows" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="CardsViewButton" Style="{StaticResource BarToggleButton}" Padding="7,1" Height="26" Margin="2,0,0,0"
                                  ToolTip="Entries as cards" Click="CardsView_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarIcon}" Text="&#xF0E2;" />
                            <TextBlock Text="Cards" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <Grid x:Name="SearchArea" DockPanel.Dock="Right" Width="300" Margin="8,0,4,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource FieldTextBox}" Padding="22,0,8,0" FontSize="12"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="8,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="SearchHint" Text="Search all entries (just type)" Margin="25,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
                <TextBlock x:Name="BarText" Margin="16,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>

        <!-- Open: categories and cards. -->
        <Grid x:Name="MainArea" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource SubtleButton}" Margin="10" Padding="8,4"
                            HorizontalAlignment="Left" ToolTip="A new category" Click="NewCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BarIcon}" Text="&#xE710;" />
                            <TextBlock Text="New category" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Top" Text="Categories" Margin="20,16,0,6" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <!-- Drag a category to set the order (or Alt+Up / Alt+Down); the line shows where it goes. -->
                    <Grid>
                        <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource CategoryItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                                 SelectionChanged="CategoryList_SelectionChanged"
                                 MouseRightButtonUp="CategoryList_MouseRightButtonUp"
                                 PreviewMouseLeftButtonDown="CategoryList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="CategoryList_PreviewMouseMove"
                                 DragOver="CategoryList_DragOver" DragLeave="CategoryList_DragLeave" Drop="CategoryList_Drop"
                                 PreviewKeyDown="CategoryList_PreviewKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="Drag to change the order (or Alt+Up / Alt+Down)">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="8,0,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="14" Width="20" Margin="0,1,10,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GroupChevronBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Rectangle x:Name="DropLine" Height="2" Margin="10,0" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                   Fill="{StaticResource GroupChevronBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                        <!-- An entry dragged onto a category: the frame shows which one it moves to. -->
                        <Rectangle x:Name="CategoryDropBox" Margin="6,0" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                   Stroke="{StaticResource GroupChevronBrush}" StrokeThickness="1.5" RadiusX="4" RadiusY="4"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="26,18,26,14">
                    <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderCount" Margin="12,0,0,2" VerticalAlignment="Bottom" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <!-- Rows: a header and the entries, one row each (keys: Up / Down, Enter edits, Ctrl+B / Ctrl+C / Ctrl+U). -->
                <Grid x:Name="RowsPanel" Grid.Row="1" Margin="20,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="12,0,26,6" TextElement.FontSize="12" TextElement.Foreground="{StaticResource SecondaryTextBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{DynamicResource RowAvatarColumn}" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Title" />
                        <TextBlock Grid.Column="2" Text="User name" Margin="22,0,0,0" />
                        <TextBlock Grid.Column="3" Text="Password" Margin="22,0,0,0" />
                        <TextBlock Grid.Column="4" Text="Web address" Margin="22,0,0,0" />
                        <TextBlock Grid.Column="5" Text="Changed" />
                    </Grid>
                    <ListBox x:Name="RowsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemTemplate="{StaticResource EntryRowTemplate}" ItemContainerStyle="{StaticResource EntryRowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             KeyDown="RowsList_KeyDown" AllowDrop="True"
                             PreviewMouseLeftButtonDown="RowsList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="RowsList_PreviewMouseMove"
                             DragOver="RowsList_DragOver" DragLeave="RowsList_DragLeave" Drop="RowsList_Drop" />
                    <!-- Where a dragged entry goes. -->
                    <Rectangle x:Name="RowDropLine" Grid.Row="1" Height="2" Margin="12,0" VerticalAlignment="Top"
                               Fill="{StaticResource GroupChevronBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <ScrollViewer x:Name="CardsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,0,12,20">
                    <ItemsControl x:Name="Cards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="40,60,40,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                           TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Locked (or no vault yet): the master password. -->
        <Border x:Name="LockPanel" Grid.Row="1" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="32,28">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="LockIcon" Source="/Assets/keeseek.ico" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="KeeSeek" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="LockTitle" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="LockHint" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Master password" />
                <PasswordBox x:Name="MasterBox" KeyDown="MasterBox_KeyDown" PasswordChanged="MasterBox_PasswordChanged" />
                <StackPanel x:Name="RepeatRow">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Repeat the master password" />
                    <PasswordBox x:Name="RepeatBox" KeyDown="MasterBox_KeyDown" />
                    <TextBlock x:Name="MasterStrength" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <TextBlock x:Name="LockError" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed" />
                <Button x:Name="UnlockButton" Style="{DynamicResource AccentButtonStyle}" Margin="0,18,0,0" MinWidth="150" Padding="14,6"
                        HorizontalAlignment="Left" Click="Unlock_Click" Content="Unlock" />
                <TextBlock x:Name="LockFile" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- New / edit entry, over the cards. -->
        <Grid x:Name="EditorLayer" Grid.Row="1" Background="#B0000000" Visibility="Collapsed">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,22">
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Title" />
                        <TextBox x:Name="TitleBox" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Category" />
                        <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                        <!-- Color (any entry) and divider. Swatches are made in code (KeeSeekView.ColorSwatches). -->
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Color" />
                        <WrapPanel x:Name="ColorSwatches" />
                        <DockPanel Margin="0,6,0,0">
                            <Border x:Name="ColorPreview" DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="4"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" />
                            <TextBlock DockPanel.Dock="Left" Text="Own color (#RRGGBB):" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="ColorBox" Width="110" HorizontalAlignment="Left" FontFamily="Consolas" TextChanged="ColorBox_TextChanged" />
                        </DockPanel>
                        <CheckBox x:Name="DividerBox" Margin="0,12,0,0" Click="DividerBox_Click"
                                  Content="Show as a divider: a row with only the title, in its color" />
                        <StackPanel x:Name="EntryFields">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="User name" />
                        <TextBox x:Name="UserBox" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                        <DockPanel>
                            <ToggleButton x:Name="GeneratorButton" DockPanel.Dock="Right" Style="{StaticResource BarToggleButton}" Margin="6,0,0,0"
                                          Padding="8,4" ToolTip="Make a random password" Click="GeneratorButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource BarIcon}" Text="&#xE8F1;" />
                                    <TextBlock Text="Generate" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button x:Name="EditorRevealButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Margin="6,0,0,0"
                                    Padding="8,4" ToolTip="Show / hide the password" Click="EditorReveal_Click">
                                <TextBlock x:Name="EditorRevealIcon" Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            </Button>
                            <Grid>
                                <PasswordBox x:Name="PasswordEdit" PasswordChanged="PasswordEdit_PasswordChanged" />
                                <TextBox x:Name="PasswordPlain" FontFamily="Consolas" Visibility="Collapsed" TextChanged="PasswordPlain_TextChanged" />
                            </Grid>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="StrengthText" DockPanel.Dock="Right" MinWidth="150" Margin="10,0,0,0" FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <ProgressBar x:Name="StrengthBar" Height="5" Minimum="0" Maximum="128" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border x:Name="GeneratorPanel" Margin="0,10,0,0" Padding="14,10" CornerRadius="6" Background="#1A1A1A"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="GenLengthText" DockPanel.Dock="Right" MinWidth="90" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <Slider x:Name="GenLength" Minimum="8" Maximum="64" Value="20" SmallChange="1" LargeChange="4"
                                            IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center" ValueChanged="GenLength_Changed" />
                                </DockPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="GenUpper" Content="A-Z" IsChecked="True" Margin="0,0,18,0" Click="GenKind_Click" />
                                    <CheckBox x:Name="GenLower" Content="a-z" IsChecked="True" Margin="0,0,18,0" Click="GenKind_Click" />
                                    <CheckBox x:Name="GenDigits" Content="0-9" IsChecked="True" Margin="0,0,18,0" Click="GenKind_Click" />
                                    <CheckBox x:Name="GenSymbols" Content="!@#$%" IsChecked="True" Margin="0,0,18,0" Click="GenKind_Click" />
                                    <Button Content="New password" Padding="10,3" Click="Generate_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Web address" />
                        <TextBox x:Name="UrlBox" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" />
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                        </StackPanel>
                        <TextBlock x:Name="EditorError" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed" />
                        <DockPanel Margin="0,20,0,0">
                            <Button x:Name="DeleteEntryButton" DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Padding="10,5"
                                    Foreground="{StaticResource ErrorBrush}" Click="DeleteEntry_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource BarIcon}" Text="&#xE74D;" />
                                    <TextBlock Text="Delete entry" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel (Esc)" MinWidth="110" Padding="10,5" Click="EditorCancel_Click" />
                                <Button Style="{DynamicResource AccentButtonStyle}" Content="Save" MinWidth="110" Padding="10,5" Margin="8,0,0,0"
                                        Click="EditorSave_Click" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- "Password copied · cleared in 18 s". -->
        <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Padding="16,9" CornerRadius="6" Background="#E0262626" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="13" />
        </Border>

        <local:KeeSeekSettingsView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</UserControl>
