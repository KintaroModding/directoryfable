<UserControl x:Class="DirectoryFable.Views.NotepadSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13"
             Foreground="{StaticResource ListTextBrush}"
             Background="{StaticResource WindowBackgroundBrush}">
    <!-- Notepad# settings: only the editor's own settings. Saved at once. -->
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource GroupChevronBrush}" />
            <Setter Property="Margin" Value="0,26,0,6" />
        </Style>
        <Style x:Key="SettingHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,24,40,40" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close (Esc)" MinWidth="100" VerticalAlignment="Center" Click="Close_Click" />
                <TextBlock Text="Notepad# settings" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="SaveStatus" Style="{StaticResource SettingHelp}" Margin="0,6,0,0"
                       Text="Changes are saved at once to settings.json." />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Editor" />

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Font" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Fixed-width fonts (every letter equally wide) are listed first." />
                    </StackPanel>
                    <ComboBox x:Name="FontBox" Grid.Column="1" VerticalAlignment="Center" MaxDropDownHeight="420"
                              SelectionChanged="FontBox_SelectionChanged">
                        <!-- Hundreds of fonts, each drawn in itself: only build the visible rows. -->
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Source}" FontFamily="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Font size" />
                        <TextBlock Style="{StaticResource SettingHelp}" Text="In points of the editor text (6 to 72)." />
                    </StackPanel>
                    <ComboBox x:Name="SizeBox" Grid.Column="1" Width="110" VerticalAlignment="Center" IsEditable="True"
                              SelectionChanged="SizeBox_Changed" LostKeyboardFocus="SizeBox_LostFocus" KeyDown="SizeBox_KeyDown" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Word wrap" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Long lines wrap at the right edge instead of scrolling sideways. Also the &quot;Word wrap&quot; button in the bar, or Alt+Z." />
                    </StackPanel>
                    <CheckBox x:Name="WrapBox" Grid.Column="1" Content="Wrap long lines" VerticalAlignment="Center"
                              Checked="WrapBox_Changed" Unchecked="WrapBox_Changed" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="File list" />

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Group the other files" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Files that are in none of your own groups are grouped automatically. Your own groups are not changed by this." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton x:Name="GroupByType" Content="By file type (.txt, .json, ...)" GroupName="AutoGroup" Checked="AutoGroup_Checked" />
                        <RadioButton x:Name="GroupByFolder" Content="By folder" GroupName="AutoGroup" Margin="0,6,0,0" Checked="AutoGroup_Checked" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Open from the explorer" />

            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.RowSpan="3" Margin="0,0,24,0">
                        <TextBlock Text="Double-click opens in Notepad#" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="A double-click (or Enter) on these file types in DirectoryFable opens them here. Only inside DirectoryFable: the Windows defaults are not changed. Separate the types with spaces. Script types such as .ahk or .bat are not in the default list, so a double-click still runs them." />
                    </StackPanel>
                    <CheckBox x:Name="OpensTypes" Grid.Column="1" Content="Open these file types in Notepad#"
                              Checked="OpensTypes_Changed" Unchecked="OpensTypes_Changed" />
                    <TextBox x:Name="TypesBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" MinHeight="0" Height="60"
                             Padding="6,4" TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top"
                             LostKeyboardFocus="TypesBox_LostFocus" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Default list" MinWidth="110" Click="TypesDefault_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Preview" />
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource EditorBackgroundBrush}"
                    Padding="12,10">
                <TextBlock x:Name="Preview" Foreground="{StaticResource EditorTextBrush}" TextWrapping="NoWrap">
                    <Run Text="; AutoHotkey" Foreground="#6A9955" /><LineBreak />
                    <Run Text="^!n::" Foreground="#4EC9B0" /><Run Text=" Run " Foreground="#DCDCAA" /><Run Text="&quot;notepad.exe&quot;" Foreground="#CE9178" /><LineBreak />
                    <Run Text="if" Foreground="#569CD6" /><Run Text=" (count &gt; " /><Run Text="10" Foreground="#B5CEA8" /><Run Text=") 0O il1I {} []" />
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
