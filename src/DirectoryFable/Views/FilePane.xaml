<UserControl x:Class="DirectoryFable.Views.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DirectoryFable.Views"
             x:Name="Root"
             FontFamily="{StaticResource UiFont}"
             FontSize="{StaticResource UiFontSize}"
             PreviewKeyDown="Pane_PreviewKeyDown"
             PreviewMouseDown="Pane_PreviewMouseDown">
    <Grid Background="{StaticResource ListBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation bar. A lighter background marks the active pane.
             Framed by fine lines: #404040 outside, then #1E1E1E, then #363636. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Border BorderBrush="{StaticResource LineDarkBrush}" BorderThickness="0,1,0,1">
        <Border Height="24" Padding="3,0" BorderBrush="{StaticResource LineLightBrush}" BorderThickness="0,1,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource NavBarInactiveBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="{StaticResource NavBarActiveBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE72B;"
                        ToolTip="Back (Alt+Left)" Click="Back_Click" IsEnabled="{Binding CanGoBack}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE72A;"
                        ToolTip="Forward (Alt+Right)" Click="Forward_Click" IsEnabled="{Binding CanGoForward}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE74A;"
                        ToolTip="Up (Alt+Up)" Click="Up_Click" IsEnabled="{Binding CanGoUp}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE72C;"
                        ToolTip="Refresh (F5)" Click="Refresh_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE80F;"
                        ToolTip="Home" Click="Home_Click" />

                <Button x:Name="HistoryButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                        Content="&#xE70D;" FontSize="8" ToolTip="Recent folders"
                        Click="History_Click" />

                <!-- Address bar: breadcrumbs, or a text box while editing. -->
                <Grid x:Name="AddressBox" Margin="6,0,0,0" Background="Transparent" Cursor="IBeam"
                      MouseLeftButtonDown="AddressBox_MouseLeftButtonDown">
                    <!-- Long paths keep their end (the current folder) and hide the first parts;
                         the "«" button then lists the hidden parts (like Explorer). -->
                    <DockPanel x:Name="BreadcrumbBar" LastChildFill="True" ClipToBounds="True">
                        <Image x:Name="FolderIcon" DockPanel.Dock="Left" Source="{Binding FolderIcon}" Width="13" Height="13" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <Button x:Name="CrumbOverflowButton" DockPanel.Dock="Left" Style="{StaticResource SubtleButton}"
                                Cursor="Arrow" Visibility="Collapsed" Padding="4,0" VerticalAlignment="Center"
                                Foreground="{StaticResource BreadcrumbTextBrush}" Content="«"
                                ToolTip="Hidden parts of the path" Click="CrumbOverflow_Click" />
                        <ItemsControl x:Name="Crumbs" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:OverflowPanel KeepEnd="True" Loaded="CrumbPanel_Loaded" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="7" Foreground="{StaticResource BreadcrumbTextBrush}"
                                                   Margin="4,1,2,0" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource SubtleButton}" Cursor="Arrow"
                                                Foreground="{StaticResource BreadcrumbTextBrush}"
                                                Content="{Binding Name}" ToolTip="{Binding Path}"
                                                Click="Breadcrumb_Click" />
                                        <!-- A "›" after the last part (part of the item, so it stays with it). -->
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="7"
                                                   Foreground="{StaticResource BreadcrumbTextBrush}"
                                                   Margin="4,1,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <TextBox x:Name="AddressEdit" Visibility="Collapsed"
                             MinHeight="0" Height="20" Padding="3,0" FontSize="12" VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             KeyDown="AddressEdit_KeyDown"
                             LostKeyboardFocus="AddressEdit_LostKeyboardFocus" />
                </Grid>
            </DockPanel>
        </Border>
        </Border>
        </Border>

        <!-- Quick actions: path to the clipboard, then file operations on the
             selection. Buttons act on this pane; see FilePane.QuickActions.cs. -->
        <Border Grid.Row="1" Height="24" Padding="3,0" Background="{StaticResource QuickBarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource QuickButton}" Click="QuickFolderPath_Click"
                        ToolTip="Copy the path of this folder to the clipboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8B7;" />
                        <TextBlock Text="Folder path" />
                    </StackPanel>
                </Button>
                <Button x:Name="QuickFilePath" Style="{StaticResource QuickButton}" Click="QuickFilePath_Click"
                        ToolTip="Copy the full path of the selected items to the clipboard (one per line)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8A5;" />
                        <TextBlock Text="File path" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="14" Margin="6,0" Fill="{StaticResource LineBrush}" />
                <!-- No Copy / Cut / Paste (the keys do that); 7-Zip "Add to archive" window instead. -->
                <Button x:Name="Quick7z" Style="{StaticResource QuickButton}" Click="Quick7z_Click"
                        ToolTip="7-Zip: add the selection to an archive (choose format and compression)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE7B8;" />
                        <TextBlock Text="7z" />
                    </StackPanel>
                </Button>
                <Button x:Name="QuickDuplicate" Style="{StaticResource QuickButton}" Click="QuickDuplicate_Click"
                        ToolTip="Duplicate: copy into this folder under a new name">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE70F;" />
                        <TextBlock Text="Duplicate" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="14" Margin="6,0" Fill="{StaticResource LineBrush}" />
                <!-- Tooltips name the other pane's folder (set when they open). -->
                <Button x:Name="QuickCopyOther" Style="{StaticResource QuickButton}" Click="QuickCopyOther_Click"
                        ToolTip="Copy the selection to the other pane" ToolTipOpening="QuickOther_ToolTipOpening">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8C8;" />
                        <TextBlock Text="Copy to other" />
                    </StackPanel>
                </Button>
                <Button x:Name="QuickMoveOther" Style="{StaticResource QuickButton}" Click="QuickMoveOther_Click"
                        ToolTip="Move the selection to the other pane" ToolTipOpening="QuickOther_ToolTipOpening">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8DE;" />
                        <TextBlock Text="Move to other" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="14" Margin="6,0" Fill="{StaticResource LineBrush}" />
                <Button x:Name="QuickTerminal" Style="{StaticResource QuickButton}" Click="QuickTerminal_Click"
                        ToolTip="Open a terminal in this folder (Command Prompt or PowerShell)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE756;" />
                        <TextBlock Text="Terminal" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickButton}" Click="QuickExplorer_Click"
                        ToolTip="Open this folder in Windows Explorer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8A7;" />
                        <TextBlock Text="Explorer" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickButton}" Click="QuickSearch_Click"
                        ToolTip="SonnetSearch in this folder and its subfolders (Ctrl+F)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE721;" />
                        <TextBlock Text="SonnetSearch" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ItemsSource is a sorted, grouped view set in code (FilePane.Columns.cs). -->
        <ListView Grid.Row="2" x:Name="FileList"
                  SelectionMode="Extended"
                  IsSynchronizedWithCurrentItem="False"
                  Style="{StaticResource FileListStyle}"
                  BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
                  ItemContainerStyle="{StaticResource FileRowStyle}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  GridViewColumnHeader.Click="ColumnHeader_Click"
                  MouseDoubleClick="FileList_MouseDoubleClick"
                  KeyDown="FileList_KeyDown"
                  AllowDrop="True"
                  PreviewMouseDown="FileList_PreviewMouseDown"
                  PreviewMouseUp="FileList_PreviewMouseUp"
                  PreviewMouseMove="FileList_PreviewMouseMove"
                  MouseRightButtonUp="FileList_MouseRightButtonUp"
                  DragEnter="FileList_DragOver"
                  DragOver="FileList_DragOver"
                  DragLeave="FileList_DragLeave"
                  Drop="FileList_Drop">
            <ListView.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource FileGroupContainerStyle}" />
            </ListView.GroupStyle>
            <ListView.View>
                <!-- Headers (with the sort arrow) are set in code; Tag = SortColumn name. -->
                <GridView x:Name="Columns" ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                    <GridViewColumn x:Name="NameColumn" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- DockPanel: the name gets the rest of the column (so long names end with "..."),
                                     the properties button sits at the right end of the Name column. -->
                                <DockPanel LastChildFill="True">
                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="13" Height="13" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,5,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RowInfoButton}"
                                            ToolTip="Properties (Alt+Enter)" Click="RowProperties_Click" />
                                    <Grid>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <!-- In-place rename (F2). Shown only while IsRenaming is true. -->
                                        <TextBox Text="{Binding DisplayName, Mode=OneTime}" MinWidth="220"
                                                 MinHeight="0" Height="20" Padding="2,0" Margin="-3,0,0,0"
                                                 VerticalContentAlignment="Center"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged"
                                                 KeyDown="RenameBox_KeyDown"
                                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TypeColumn" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="SizeColumn" Width="80"
                                    HeaderContainerStyle="{StaticResource ColumnHeaderRightStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="CreatedColumn" Width="150"
                                    HeaderContainerStyle="{StaticResource ColumnHeaderRightStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateCreatedText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ModifiedColumn" Width="150"
                                    HeaderContainerStyle="{StaticResource ColumnHeaderRightStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateModifiedText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Optional column (header right-click); hidden by default. -->
                    <GridViewColumn x:Name="ExtensionColumn" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Extension}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status bar:
             folders sel/total | files sel/total | size sel/total ... message ... (i) free space + bar.
             Numbers are filled in code (FilePane.StatusBar.cs). -->
        <Border Grid.Row="3" Height="22" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource WindowBackgroundBrush}">
            <DockPanel Margin="6,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="StatusFolderIcon" Width="13" Height="13" Margin="0,0,5,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="StatusFolders" />
                    <Rectangle Width="1" Height="14" Margin="9,0" Fill="{StaticResource LineBrush}" />
                    <Image x:Name="StatusFileIcon" Width="13" Height="13" Margin="0,0,5,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="StatusFiles" />
                    <Rectangle Width="1" Height="14" Margin="9,0" Fill="{StaticResource LineBrush}" />
                    <TextBlock x:Name="StatusSizes" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            x:Name="StatusSpacePanel">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource GroupChevronBrush}" VerticalAlignment="Center"
                               Margin="0,0,6,0" x:Name="StatusInfoIcon" />
                    <TextBlock x:Name="StatusFree" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <!-- Usage bar: blue = used, light = free. -->
                    <Grid Width="60" Height="10" VerticalAlignment="Center">
                        <Border Background="#E6E6E6" />
                        <Border x:Name="StatusUsedBar" Background="{StaticResource GroupChevronBrush}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </StackPanel>

                <!-- Messages ("3 item(s) copied", errors) between the two parts. -->
                <TextBlock Text="{Binding StatusText}" Margin="14,0" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
