<UserControl x:Class="DirectoryFable.Views.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DirectoryFable.Views"
             x:Name="Root"
             FontFamily="{StaticResource UiFont}"
             FontSize="{StaticResource UiFontSize}"
             PreviewKeyDown="Pane_PreviewKeyDown"
             PreviewMouseDown="Pane_PreviewMouseDown">
    <UserControl.Resources>
        <!-- "Compare" (action bar): how a row or tile stands against the other pane. -->
        <Style x:Key="CompareMarkText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#808080" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompareMark}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompareMark}" Value="only">
                    <Setter Property="Foreground" Value="#6CCB5F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompareMark}" Value="newer">
                    <Setter Property="Foreground" Value="#4FC1FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompareMark}" Value="differs">
                    <Setter Property="Foreground" Value="#D7BA7D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Tile view (FilePane.Tiles.cs): sizes follow the size slider through these resources. -->
        <system:Double x:Key="TilePictureWidth" xmlns:system="clr-namespace:System;assembly=System.Runtime">256</system:Double>
        <system:Double x:Key="TilePictureHeight" xmlns:system="clr-namespace:System;assembly=System.Runtime">144</system:Double>
        <system:Double x:Key="TileWidth" xmlns:system="clr-namespace:System;assembly=System.Runtime">276</system:Double>
        <system:Double x:Key="TileHeight" xmlns:system="clr-namespace:System;assembly=System.Runtime">216</system:Double>

        <!-- A tile: hover, selection, focus, drop target and "cut" as the rows show them. -->
        <Style x:Key="FileTileStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource ListTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Margin="3" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelectedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelectedHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRectBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GroupChevronBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCut}" Value="True">
                                <Setter TargetName="Content" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Picture (a video's length in the corner), the name in up to two lines, the size. -->
        <DataTemplate x:Key="FileTileTemplate">
            <StackPanel Margin="6,6,6,4">
                <Grid Width="{DynamicResource TilePictureWidth}" Height="{DynamicResource TilePictureHeight}">
                    <local:ThumbImage x:Name="Thumb" Item="{Binding}" BoxWidth="{DynamicResource TilePictureWidth}" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Padding="4,0,4,1"
                            Background="#C0000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Duration, ElementName=Thumb}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Duration, ElementName=Thumb}" FontSize="11" Foreground="White" />
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Padding="4,0,4,1"
                            Background="#C0000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompareMark}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CompareText}" Style="{StaticResource CompareMarkText}" />
                    </Border>
                </Grid>
                <Grid Margin="0,4,0,0" Width="{DynamicResource TilePictureWidth}" Height="32">
                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center" ToolTip="{Binding DisplayName}" />
                </Grid>
                <TextBlock Text="{Binding SizeText}" TextAlignment="Center" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TilePanelTemplate">
            <local:TilePanel TileWidth="{DynamicResource TileWidth}" TileHeight="{DynamicResource TileHeight}" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource ListBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation bar. A lighter background marks the active pane; on a network path it is blue.
             Framed by fine lines: #404040 outside, then #1E1E1E, then #363636. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Border BorderBrush="{StaticResource LineDarkBrush}" BorderThickness="0,1,0,1">
        <Border Height="24" Padding="3,0" BorderBrush="{StaticResource LineLightBrush}" BorderThickness="0,1,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource NavBarInactiveBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="{StaticResource NavBarActiveBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                            <Setter Property="Background" Value="{StaticResource NetworkNavBarInactiveBrush}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsNetwork}" Value="True" />
                                <Condition Binding="{Binding IsActive}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource NetworkNavBarActiveBrush}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE72B;"
                        ToolTip="Back (Alt+Left)" Click="Back_Click" IsEnabled="{Binding CanGoBack}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE72A;"
                        ToolTip="Forward (Alt+Right)" Click="Forward_Click" IsEnabled="{Binding CanGoForward}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE74A;"
                        ToolTip="Up (Alt+Up)" Click="Up_Click" IsEnabled="{Binding CanGoUp}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE72C;"
                        ToolTip="Refresh (F5)" Click="Refresh_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}" Content="&#xE80F;"
                        ToolTip="Home" Click="Home_Click" />

                <Button x:Name="HistoryButton" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                        Content="&#xE70D;" FontSize="8" ToolTip="Recent folders"
                        Click="History_Click" />

                <!-- Address bar: breadcrumbs, or a text box while editing. -->
                <Grid x:Name="AddressBox" Margin="6,0,0,0" Background="Transparent" Cursor="IBeam"
                      MouseLeftButtonDown="AddressBox_MouseLeftButtonDown">
                    <!-- Long paths keep their end (the current folder) and hide the first parts;
                         the "«" button then lists the hidden parts (like Explorer). -->
                    <DockPanel x:Name="BreadcrumbBar" LastChildFill="True" ClipToBounds="True">
                        <Image x:Name="FolderIcon" DockPanel.Dock="Left" Source="{Binding FolderIcon}" Width="13" Height="13" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,4,0"
                               VerticalAlignment="Center" />
                        <Button x:Name="CrumbOverflowButton" DockPanel.Dock="Left" Style="{StaticResource SubtleButton}"
                                Cursor="Arrow" Visibility="Collapsed" Padding="4,0" VerticalAlignment="Center"
                                Foreground="{StaticResource BreadcrumbTextBrush}" Content="«"
                                ToolTip="Hidden parts of the path" Click="CrumbOverflow_Click" />
                        <ItemsControl x:Name="Crumbs" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:OverflowPanel KeepEnd="True" Loaded="CrumbPanel_Loaded" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="7" Foreground="{StaticResource BreadcrumbTextBrush}"
                                                   Margin="4,1,2,0" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource SubtleButton}" Cursor="Arrow"
                                                Foreground="{StaticResource BreadcrumbTextBrush}"
                                                Content="{Binding Name}" ToolTip="{Binding Path}"
                                                Click="Breadcrumb_Click" />
                                        <!-- A "›" after the last part (part of the item, so it stays with it). -->
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="7"
                                                   Foreground="{StaticResource BreadcrumbTextBrush}"
                                                   Margin="4,1,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <TextBox x:Name="AddressEdit" Visibility="Collapsed"
                             MinHeight="0" Height="20" Padding="3,0" FontSize="12" VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             KeyDown="AddressEdit_KeyDown"
                             LostKeyboardFocus="AddressEdit_LostKeyboardFocus" />
                </Grid>
            </DockPanel>
        </Border>
        </Border>
        </Border>

        <!-- Quick actions in two rows. Row 1: paths to the clipboard, file operations on the selection.
             Row 2: terminal, Explorer, SonnetSearch, Space, and the quick filter. Buttons act on this pane;
             see FilePane.QuickActions.cs. Settings "Quick bar: icons only" hides the labels. -->
        <Border x:Name="QuickBar" Grid.Row="1" Padding="3,0" Background="{StaticResource QuickBarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel x:Name="QuickButtons" Orientation="Horizontal" Height="24" VerticalAlignment="Center" ClipToBounds="True">
                    <Button Style="{StaticResource QuickButton}" Click="QuickFolderPath_Click"
                            ToolTip="Copy the path of this folder to the clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8B7;" />
                            <TextBlock Text="Folder path" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickFilePath" Style="{StaticResource QuickButton}" Click="QuickFilePath_Click"
                            ToolTip="Copy the full path of the selected items to the clipboard (one per line)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8A5;" />
                            <TextBlock Text="File path" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="6,0" Fill="{StaticResource LineBrush}" />
                    <!-- The same as Ctrl+C / Ctrl+X / Ctrl+V. -->
                    <Button x:Name="QuickCopy" Style="{StaticResource QuickButton}" Click="QuickCopy_Click"
                            ToolTip="Copy the selection to the clipboard (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8C8;" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickCut" Style="{StaticResource QuickButton}" Click="QuickCut_Click"
                            ToolTip="Cut the selection to the clipboard (Ctrl+X)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8C6;" />
                            <TextBlock Text="Cut" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickButton}" Click="QuickPaste_Click"
                            ToolTip="Paste into this folder (Ctrl+V)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE77F;" />
                            <TextBlock Text="Paste" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="6,0" Fill="{StaticResource LineBrush}" />
                    <!-- 7-Zip's "Add to archive" window. -->
                    <Button x:Name="Quick7z" Style="{StaticResource QuickButton}" Click="Quick7z_Click"
                            ToolTip="7-Zip: add the selection to an archive (choose format and compression)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE7B8;" />
                            <TextBlock Text="7z" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickDuplicate" Style="{StaticResource QuickButton}" Click="QuickDuplicate_Click"
                            ToolTip="Duplicate: copy into this folder under a new name">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE70F;" />
                            <TextBlock Text="Duplicate" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="6,0" Fill="{StaticResource LineBrush}" />
                    <!-- Tooltips name the other pane's folder (set when they open). -->
                    <Button x:Name="QuickCopyOther" Style="{StaticResource QuickButton}" Click="QuickCopyOther_Click"
                            ToolTip="Copy the selection to the other pane" ToolTipOpening="QuickOther_ToolTipOpening">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8C8;" />
                            <TextBlock Text="Copy to other" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickMoveOther" Style="{StaticResource QuickButton}" Click="QuickMoveOther_Click"
                            ToolTip="Move the selection to the other pane" ToolTipOpening="QuickOther_ToolTipOpening">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8DE;" />
                            <TextBlock Text="Move to other" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="14" Margin="6,0" Fill="{StaticResource LineBrush}" />
                    <!-- Delete as a split button: the main part = Delete key (Recycle Bin), the arrow = Shift+Delete
                         (permanently, after DirectoryFable's question). -->
                    <Button x:Name="QuickDelete" Style="{StaticResource QuickButton}" Margin="0" Click="QuickDelete_Click"
                            ToolTip="Delete: move the selection to the Recycle Bin (Delete)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE74D;" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickDeletePermanent" Style="{StaticResource QuickButton}" Padding="3,0"
                            Click="QuickDeletePermanent_Click"
                            ToolTip="Delete permanently, not to the Recycle Bin (Shift+Delete): asks first">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="0,2,0,0"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
                <Rectangle Height="1" Fill="{StaticResource LineDarkBrush}" Margin="-3,0" />
                <DockPanel Height="24" LastChildFill="True">
                <!-- Quick filter: typing in the list types here; only matching names stay in the list. -->
                <Grid x:Name="FilterBox" DockPanel.Dock="Right" Width="210" Margin="8,0,1,0" VerticalAlignment="Center"
                      ToolTip="Quick filter: type in the list (words in any order, * and ? as wildcards). Esc shows all again.">
                    <TextBox x:Name="FilterEdit" MinHeight="0" Height="20" Padding="20,0,22,0" FontSize="12"
                             VerticalContentAlignment="Center" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="FilterEdit_KeyDown" />
                    <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                               Foreground="{StaticResource SecondaryTextBrush}" x:Name="FilterIcon" />
                    <TextBlock x:Name="FilterHint" Text="Type to filter" Margin="21,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                        <TextBlock x:Name="FilterCount" VerticalAlignment="Center" Margin="0,0,4,0" IsHitTestVisible="False"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button x:Name="FilterClear" Style="{StaticResource SubtleButton}" Padding="3,1" Visibility="Collapsed"
                                ToolTip="Show all (Esc)" Click="FilterClear_Click">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       Foreground="{StaticResource BreadcrumbTextBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
                    <StackPanel x:Name="QuickButtons2" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <Button x:Name="QuickChat" Style="{StaticResource QuickButton}" Click="QuickChat_Click"
                            ToolTip="GemmaChat in this folder: a new chat where the AI can work on its files (you approve every change)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8BD;" />
                            <TextBlock Text="GemmaChat" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QuickTerminal" Style="{StaticResource QuickButton}" Click="QuickTerminal_Click"
                            ToolTip="Open a terminal in this folder (Command Prompt or PowerShell)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE756;" />
                            <TextBlock Text="Terminal" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickButton}" Click="QuickExplorer_Click"
                            ToolTip="Open this folder in Windows Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE8A7;" />
                            <TextBlock Text="Explorer" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuickButton}" Click="QuickSearch_Click"
                            ToolTip="SonnetSearch in this folder and its subfolders (Ctrl+F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xE721;" />
                            <TextBlock Text="SonnetSearch" />
                        </StackPanel>
                    </Button>
                    <!-- Space view on / off (highlighted while on). -->
                    <Button x:Name="QuickSpace" Click="QuickSpace_Click"
                            ToolTip="Space: what takes the space in this folder, biggest first (Esc: back to the list)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuickButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpaceMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource TreeSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xEB05;" />
                            <TextBlock Text="Space" />
                        </StackPanel>
                    </Button>
                    <!-- Tile view on / off (highlighted while on), with its size slider while on. -->
                    <Button x:Name="QuickTiles" Click="QuickTiles_Click"
                            ToolTip="Thumbnails: large pictures of the files instead of rows (Ctrl+mouse wheel: size)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuickButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TileMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource TreeSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QuickIcon}" Text="&#xF0E2;" />
                            <TextBlock Text="Thumbnails" />
                        </StackPanel>
                    </Button>
                    <!-- Scaled down: the standard slider (with its thumb) is taller than the 24 px row, which clips. -->
                    <Slider x:Name="TileSizeSlider" Width="130" Margin="4,0,0,0" VerticalAlignment="Center"
                            Minimum="128" Maximum="512" SmallChange="16" LargeChange="64" IsMoveToPointEnabled="True"
                            Focusable="False" ToolTip="Size of the thumbnails (Ctrl+mouse wheel in the list)"
                            ValueChanged="TileSizeSlider_ValueChanged">
                        <Slider.LayoutTransform>
                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                        </Slider.LayoutTransform>
                        <Slider.Style>
                            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TileMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Slider.Style>
                    </Slider>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ItemsSource is a sorted, grouped view set in code (FilePane.Columns.cs). -->
        <ListView Grid.Row="2" x:Name="FileList"
                  SelectionMode="Extended"
                  IsSynchronizedWithCurrentItem="False"
                  Style="{StaticResource FileListStyle}"
                  BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
                  ItemContainerStyle="{StaticResource FileRowStyle}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  IsTextSearchEnabled="False"
                  GridViewColumnHeader.Click="ColumnHeader_Click"
                  MouseDoubleClick="FileList_MouseDoubleClick"
                  KeyDown="FileList_KeyDown"
                  PreviewTextInput="FileList_PreviewTextInput"
                  PreviewMouseWheel="FileList_PreviewMouseWheel"
                  AllowDrop="True"
                  PreviewMouseDown="FileList_PreviewMouseDown"
                  PreviewMouseUp="FileList_PreviewMouseUp"
                  PreviewMouseMove="FileList_PreviewMouseMove"
                  MouseRightButtonUp="FileList_MouseRightButtonUp"
                  DragEnter="FileList_DragOver"
                  DragOver="FileList_DragOver"
                  DragLeave="FileList_DragLeave"
                  Drop="FileList_Drop">
            <ListView.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource FileGroupContainerStyle}" />
            </ListView.GroupStyle>
            <ListView.View>
                <!-- Headers (with the sort arrow) are set in code; Tag = SortColumn name. -->
                <GridView x:Name="Columns" ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                    <GridViewColumn x:Name="NameColumn" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- DockPanel: the name gets the rest of the column (so long names end with "..."),
                                     the properties button sits at the right end of the Name column. -->
                                <DockPanel LastChildFill="True">
                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="13" Height="13" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,5,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RowInfoButton}"
                                            ToolTip="Properties (Alt+Enter)" Click="RowProperties_Click" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CompareText}" Style="{StaticResource CompareMarkText}"
                                               Margin="8,0,2,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TypeColumn" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="SizeColumn" Width="80"
                                    HeaderContainerStyle="{StaticResource ColumnHeaderRightStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="CreatedColumn" Width="150"
                                    HeaderContainerStyle="{StaticResource ColumnHeaderRightStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateCreatedText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ModifiedColumn" Width="150"
                                    HeaderContainerStyle="{StaticResource ColumnHeaderRightStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateModifiedText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Optional column (header right-click); hidden by default. -->
                    <GridViewColumn x:Name="ExtensionColumn" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Extension}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- The quick filter hides every row. -->
        <TextBlock x:Name="FilterEmptyText" Grid.Row="2" Margin="20,60,20,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                   TextAlignment="Center" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                   IsHitTestVisible="False" Visibility="Collapsed" />

        <!-- This PC: the drives instead of the file list (Views/DrivesView). -->
        <local:DrivesView x:Name="Drives" Grid.Row="2" Visibility="Collapsed" />

        <!-- Space view: what takes the space, instead of the file list (Views/SpaceView). -->
        <local:SpaceView x:Name="Space" Grid.Row="2" Visibility="Collapsed" />

        <!-- Status bar:
             folders sel/total | files sel/total | size sel/total ... message ... (i) free space + bar.
             Numbers are filled in code (FilePane.StatusBar.cs). -->
        <Border Grid.Row="3" Height="22" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource WindowBackgroundBrush}">
            <DockPanel Margin="6,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="StatusFolderIcon" Width="13" Height="13" Margin="0,0,5,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="StatusFolders" />
                    <Rectangle Width="1" Height="14" Margin="9,0" Fill="{StaticResource LineBrush}" />
                    <Image x:Name="StatusFileIcon" Width="13" Height="13" Margin="0,0,5,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="StatusFiles" />
                    <Rectangle Width="1" Height="14" Margin="9,0" Fill="{StaticResource LineBrush}" />
                    <TextBlock x:Name="StatusSizes" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            x:Name="StatusSpacePanel">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource GroupChevronBrush}" VerticalAlignment="Center"
                               Margin="0,0,6,0" x:Name="StatusInfoIcon" />
                    <TextBlock x:Name="StatusFree" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <!-- Usage bar: blue = used, light = free. -->
                    <Grid Width="60" Height="10" VerticalAlignment="Center">
                        <Border Background="#E6E6E6" />
                        <Border x:Name="StatusUsedBar" Background="{StaticResource GroupChevronBrush}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </StackPanel>

                <!-- DirectoryFable's RAM use, left of the free space (one pane only, see FilePane.ShowsMemory). -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            x:Name="StatusMemoryPanel" Visibility="Collapsed"
                            ToolTip="RAM used by DirectoryFable (private working set, as Task Manager's Memory column); every 2 seconds">
                    <TextBlock x:Name="StatusMemory" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <Rectangle Width="1" Height="14" Margin="9,0" Fill="{StaticResource LineBrush}" />
                </StackPanel>

                <!-- Messages ("3 item(s) copied", errors) between the two parts. -->
                <TextBlock Text="{Binding StatusText}" Margin="14,0" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
