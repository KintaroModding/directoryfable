<UserControl x:Class="DirectoryFable.Views.DrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ListBackgroundBrush}"
             Foreground="{StaticResource ListTextBrush}"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <!-- This PC: the drives with a usage bar, file system and free space (like Windows' "Devices and drives"). -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="BarTrackBrush" Color="#DADADA" />
        <SolidColorBrush x:Key="BarFillBrush" Color="#1A6FD1" />
        <SolidColorBrush x:Key="BarFullBrush" Color="#D63B3B" />
    </UserControl.Resources>
    <ListBox x:Name="List" BorderThickness="0" Background="Transparent" Padding="6,4,6,10"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}"
             MouseDoubleClick="List_MouseDoubleClick" PreviewMouseDown="List_PreviewMouseDown"
             MouseRightButtonUp="List_MouseRightButtonUp" KeyDown="List_KeyDown">
        <ListBox.GroupStyle>
            <GroupStyle>
                <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                        <!-- "Devices and drives (4) ————", like the file list's group dividers. -->
                        <DockPanel Margin="4,10,4,4">
                            <TextBlock DockPanel.Dock="Left" FontSize="13" Foreground="{StaticResource ListTextBrush}">
                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding ItemCount, StringFormat=' ({0})', Mode=OneWay}" />
                            </TextBlock>
                            <Rectangle Height="1" Margin="10,1,0,0" VerticalAlignment="Center" Fill="{StaticResource LineBrush}" />
                        </DockPanel>
                    </DataTemplate>
                </GroupStyle.HeaderTemplate>
            </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                    Padding="12,8,12,8" Margin="12,0,0,0">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ListSelectedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid ToolTip="{Binding ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="620" />
                        <ColumnDefinition Width="Auto" MinWidth="220" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Name, Mode=OneWay}" FontSize="14" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" />
                        </TextBlock>
                        <!-- Usage bar: red from 90 % used, as in Windows. -->
                        <Grid Height="14" Margin="0,5,0,0" Visibility="{Binding BarVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding UsedWidth}" />
                                <ColumnDefinition Width="{Binding FreeWidth}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{StaticResource BarTrackBrush}" />
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BarFillBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BarFullBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Line1}" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Line2}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
