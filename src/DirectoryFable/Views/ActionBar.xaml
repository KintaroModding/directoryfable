<UserControl x:Class="DirectoryFable.Views.ActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="{StaticResource FavoritesBarHeight}"
             BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
             FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FavoritesFontSize}"
             Background="{StaticResource WindowBackgroundBrush}">
    <!-- App-wide actions between the title bar and the favorites bar:
         icon + text buttons, same size as the favorites. Right of "Undo": what it would undo. -->
    <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
        <!-- Opens / closes the settings page (it covers everything below this bar). -->
        <ToggleButton x:Name="SettingsButton" Style="{StaticResource BarToggleButton}" Padding="7,1" Height="26"
                      ToolTip="Settings" Click="Settings_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Margin="0,1,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
        <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
        <Button x:Name="UndoButton" Style="{StaticResource SubtleButton}" Padding="7,1" Height="26"
                IsEnabled="False" Click="Undo_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Margin="0,1,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Undo" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <TextBlock x:Name="UndoHint" Margin="6,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}" />
        <Rectangle Width="1" Height="14" Margin="10,0" Fill="{StaticResource LineBrush}" />
        <Button Style="{StaticResource SubtleButton}" Padding="7,1" Height="26"
                ToolTip="Reload the folders of both panes" Click="RefreshBoth_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Margin="0,1,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Refresh both" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <!-- Compares the folders of the two panes while on: marks on the rows (only here, newer, older, differs). -->
        <ToggleButton x:Name="CompareButton" Style="{StaticResource BarToggleButton}" Padding="7,1" Height="26" Margin="2,0,0,0"
                      ToolTip="Compare the folders of the two panes: marks what is only on one side, newer, older or different, and selects what is only here or newer here. Click again to end."
                      Click="Compare_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Margin="0,1,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Compare" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
    </StackPanel>
</UserControl>
