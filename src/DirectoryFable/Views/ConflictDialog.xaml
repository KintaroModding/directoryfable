<Window x:Class="DirectoryFable.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name already taken" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ListTextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <!-- DirectoryFable's own "replace or skip" question (Shell/ConflictPlanner.cs), asked before the copy starts. -->
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,4,14,0" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ListBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="CountText" Foreground="{StaticResource SecondaryTextBrush}" />
        <TextBlock x:Name="HeadText" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="SourceTitle" FontWeight="SemiBold" Text="New (from ...)" TextTrimming="CharacterEllipsis" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Size" />
                        <TextBlock x:Name="SourceSize" Grid.Column="1" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Modified" />
                        <TextBlock x:Name="SourceDate" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="TargetTitle" FontWeight="SemiBold" Text="Already there (in ...)" TextTrimming="CharacterEllipsis" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Size" />
                        <TextBlock x:Name="TargetSize" Grid.Column="1" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Modified" />
                        <TextBlock x:Name="TargetDate" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="SameText" Margin="0,10,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />

        <StackPanel Margin="0,18,0,0">
            <Button x:Name="ReplaceButton" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,8" Click="Replace_Click">
                <StackPanel>
                    <TextBlock Text="Replace" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReplaceHint" Text="The new one takes its place." FontSize="12" Opacity="0.85" />
                </StackPanel>
            </Button>
            <Button x:Name="NewerButton" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,8" Click="ReplaceIfNewer_Click">
                <StackPanel>
                    <TextBlock Text="Replace if newer" FontWeight="SemiBold" />
                    <TextBlock x:Name="NewerHint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,8" Click="Skip_Click">
                <StackPanel>
                    <TextBlock Text="Skip" FontWeight="SemiBold" />
                    <TextBlock Text="Nothing changes for this one; the one there stays." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Button>
            <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,8" Click="KeepBoth_Click">
                <StackPanel>
                    <TextBlock Text="Keep both" FontWeight="SemiBold" />
                    <TextBlock x:Name="KeepBothHint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="110" IsCancel="True" Click="Cancel_Click"
                    ToolTip="Nothing is copied or moved" />
            <CheckBox x:Name="AllBox" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</Window>
